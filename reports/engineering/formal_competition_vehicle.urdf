  <gazebo reference="lidar_2d_link">
    <sensor name="utm30lx" type="gpu_lidar">
      <topic>/sensors/lidar_2d/scan</topic>
      <update_rate>40</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <gz_frame_id>lidar_2d_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1</resolution>
            <min_angle>-2.356194</min_angle>
            <max_angle>2.356194</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.030</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- Livox MID-360 physical envelope and non-repeating scan approximation. -->
  <link name="lidar_3d_link">
    <visual name="mid360_mesh">
      <!-- The vendor STL is millimetres; the sensor datum sits 36.5 mm
             above the base used by the Robotnik visual. -->
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.0365"/>
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/livox_mid_360.stl" scale="0.001 0.001 0.001"/>
      </geometry>
