  <!-- ZED-F9P receiver mass is represented together with ANN-MB-00 antenna. -->
  <link name="gnss_antenna_link">
    <visual name="ann_mb_mesh">
      <origin xyz="0 0 -0.01125"/>
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/antenna_ANN_MB.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.0607 0.083 0.0225"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="0.000026" ixy="0" ixz="0" iyy="0.000026" iyz="0" izz="0.000045"/>
    </inertial>
  </link>
  <joint name="gnss_antenna_mount_joint" type="fixed">
    <parent link="sensor_mast_link"/>
    <child link="gnss_antenna_link"/>
    <origin xyz="-0.100 0 0.965"/>
  </joint>
  <gazebo reference="gnss_antenna_link">
    <sensor name="zed_f9p" type="navsat">
      <topic>/sensors/gnss/fix</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>gnss_antenna_link</gz_frame_id>
      <!-- Gazebo NavSat horizontal noise is expressed in degrees. 9e-8 deg
             is approximately 1 cm at the equator, matching the RTK target. -->
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.00000009</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>
  <!-- VN-100 Rugged body is located near the vehicle CoG, not on the mast. -->
  <link name="imu_link">
    <!-- Invert Robotnik's base-to-measurement-frame offset so imu_link
           remains the Gazebo/ROS measurement frame. -->
    <visual name="vn100_mesh">
      <origin xyz="0.00745 0 -0.0088"/>
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/vectornav_vn100.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.00745 0 -0.0043"/>
      <geometry>
        <box size="0.036 0.037 0.009"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.00745 0 -0.0043"/>
      <mass value="0.015"/>
      <inertia ixx="1.8124999999999994e-06" ixy="0" ixz="0" iyy="1.7212499999999996e-06" iyz="0" izz="3.3312499999999997e-06"/>
    </inertial>
  </link>
  <joint name="imu_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.244"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="vn100" type="imu">
      <topic>/sensors/imu/data</topic>
      <update_rate>200</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.00061</stddev>
              <bias_mean>0</bias_mean>
              <bias_stddev>0.00002</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.00061</stddev>
              <bias_mean>0</bias_mean>
              <bias_stddev>0.00002</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.00061</stddev>
              <bias_mean>0</bias_mean>
              <bias_stddev>0.00002</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.04</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.04</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.04</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
