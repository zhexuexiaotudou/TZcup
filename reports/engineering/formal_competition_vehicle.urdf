        <color rgba="0.23 0.25 0.26 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.075 0.84 0.045"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.014742187499999998" ixy="0" ixz="0" iyy="0.00015937499999999998" iyz="0" izz="0.014817187499999997"/>
    </inertial>
  </link>
  <joint name="squeegee_float_joint" type="prismatic">
    <parent link="cleaning_lift_carriage_link"/>
    <child link="squeegee_float_carrier_link"/>
    <!-- At q=0.100 m downstroke and zero float/pitch displacement,
           the rubber blade collision is tangent to z=0 and the intake retains
           a 5 mm geometric gap.  The +/-15 mm joint remains compliance travel;
           this datum is not physical contact-force evidence. -->
    <origin rpy="0 0 0" xyz="-0.445 0 -0.0376"/>
    <axis xyz="0 0 1"/>
    <limit effort="250.0" lower="-0.015" upper="0.015" velocity="0.10"/>
    <dynamics damping="45.0" friction="4.0"/>
  </joint>
  <link name="squeegee_spring_pack_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
