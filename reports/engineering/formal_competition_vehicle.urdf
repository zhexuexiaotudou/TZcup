    <child link="squeegee_spring_pack_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="squeegee_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/project/cleaning/squeegee_backing.stl"/>
      </geometry>
