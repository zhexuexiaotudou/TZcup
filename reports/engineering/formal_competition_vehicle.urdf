  <!-- Every fixed sensor is connected through a named, physical mounting
         link.  This makes the installation hierarchy inspectable in TF/URDF
         and keeps the visible vendor housing separate from project-owned CAD. -->
  <!-- Hokuyo UTM-30LX: 60 x 60 x 87 mm, 0.37 kg, 270 deg at 40 Hz. -->
  <link name="lidar_2d_mount_link">
    <visual name="utm30lx_bracket_visual">
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/utm30lx_mount.stl"/>
      </geometry>
      <material name="sensor_mount_silver">
        <color rgba="0.42 0.46 0.47 1"/>
      </material>
    </visual>
    <collision name="utm_shelf_collision">
      <origin xyz="0.020 0 0.006"/>
      <geometry>
        <box size="0.150 0.120 0.014"/>
      </geometry>
    </collision>
    <collision name="utm_backplate_collision">
      <origin xyz="-0.048 0 -0.030"/>
      <geometry>
        <box size="0.014 0.105 0.090"/>
      </geometry>
    </collision>
    <collision name="utm_pad_collision">
      <origin xyz="0.055 0 0.019"/>
      <geometry>
        <box size="0.100 0.090 0.008"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.42"/>
      <inertia ixx="0.0009274999999999999" ixy="0" ixz="0" iyy="0.001211" iyz="0" izz="0.0012915"/>
    </inertial>
  </link>
  <joint name="lidar_2d_bracket_joint" type="fixed">
    <parent link="sensor_mast_link"/>
    <child link="lidar_2d_mount_link"/>
    <!-- Keep the 270 degree measurement plane above the moulded mast
           fairing.  The 47 mm vertical clearance prevents the rear edge of
           the physical fairing from masking both side sectors. -->
    <origin xyz="0.060 0 0.695"/>
  </joint>
  <link name="lidar_2d_link">
    <visual name="utm30lx_mesh">
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/hokuyo_utm_30lx.dae"/>
      </geometry>
      <material name="utm30lx_blue">
        <color rgba="0.08 0.29 0.44 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0115"/>
      <geometry>
        <box size="0.060 0.060 0.087"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.0115"/>
      <mass value="0.37"/>
      <inertia ixx="0.0003443775" ixy="0" ixz="0" iyy="0.0003443775" iyz="0" izz="0.00022199999999999998"/>
    </inertial>
  </link>
  <joint name="lidar_2d_mount_joint" type="fixed">
    <parent link="lidar_2d_mount_link"/>
    <child link="lidar_2d_link"/>
    <origin xyz="0.055 0 0.078"/>
  </joint>
  <gazebo reference="lidar_2d_link">
    <sensor name="utm30lx" type="gpu_lidar">
      <topic>/sensors/lidar_2d/scan</topic>
      <update_rate>40</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <gz_frame_id>lidar_2d_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1080</samples>
            <resolution>1</resolution>
            <min_angle>-2.356194</min_angle>
            <max_angle>2.356194</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.030</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- Livox MID-360 physical envelope and non-repeating scan approximation. -->
  <link name="lidar_3d_mount_link">
    <visual name="mid360_isolator_plate_visual">
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/mid360_mount.stl"/>
      </geometry>
      <material name="mid360_mount_silver">
        <color rgba="0.48 0.52 0.53 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.017"/>
      <geometry>
        <cylinder length="0.034" radius="0.070"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.017"/>
      <mass value="0.28"/>
      <inertia ixx="0.000360" ixy="0" ixz="0" iyy="0.000360" iyz="0" izz="0.000686"/>
    </inertial>
  </link>
  <joint name="lidar_3d_bracket_joint" type="fixed">
    <parent link="sensor_mast_link"/>
    <child link="lidar_3d_mount_link"/>
    <origin xyz="0 0 0.790"/>
  </joint>
  <link name="lidar_3d_link">
    <visual name="mid360_mesh">
      <!-- The vendor STL is millimetres; the sensor datum sits 36.5 mm
             above the base used by the Robotnik visual. -->
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.0365"/>
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/livox_mid_360.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mid360_dark_gray">
        <color rgba="0.11 0.13 0.14 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0325"/>
      <geometry>
        <cylinder length="0.060" radius="0.041"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.0325"/>
      <mass value="0.265"/>
      <inertia ixx="0.000103" ixy="0" ixz="0" iyy="0.000103" iyz="0" izz="0.000140"/>
    </inertial>
  </link>
  <joint name="lidar_3d_mount_joint" type="fixed">
    <parent link="lidar_3d_mount_link"/>
    <child link="lidar_3d_link"/>
    <origin xyz="0 0 0.094"/>
  </joint>
  <gazebo reference="lidar_3d_link">
    <sensor name="mid360" type="gpu_lidar">
      <!-- Gazebo publishes LaserScan on this base topic and PointCloudPacked
             on its /points child.  Keep the base free of the /points suffix so
             the ROS PointCloud2 contract is exactly /sensors/lidar_3d/points. -->
      <topic>/sensors/lidar_3d</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <gz_frame_id>lidar_3d_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1800</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
          <!-- MID-360 published vertical field of view: -7 to +52 degrees. -->
          <vertical>
            <samples>64</samples>
            <resolution>1</resolution>
            <min_angle>-0.122173</min_angle>
            <max_angle>0.907571</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.020</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <link name="front_rgbd_mount_link">
    <visual name="front_rgbd_bezel_visual">
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/front_rgbd_mount.stl"/>
      </geometry>
      <material name="front_rgbd_bezel">
        <color rgba="0.055 0.070 0.073 1"/>
      </material>
    </visual>
    <collision name="front_rgbd_upper_bezel">
      <origin xyz="0 0 0.030"/>
      <geometry>
        <box size="0.045 0.132 0.008"/>
