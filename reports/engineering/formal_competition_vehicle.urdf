      </geometry>
      <material name="hf_spring">
        <color rgba="0.70 0.72 0.73 1"/>
      </material>
    </visual>
    <collision name="left_spring_collision">
      <origin xyz="0 0.30 0.050"/>
      <geometry>
        <cylinder length="0.085" radius="0.016"/>
      </geometry>
    </collision>
    <collision name="right_spring_collision">
      <origin xyz="0 -0.30 0.050"/>
      <geometry>
        <cylinder length="0.085" radius="0.016"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.050"/>
      <mass value="0.08"/>
