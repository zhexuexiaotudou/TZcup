    <parent link="front_rgbd_link"/>
    <child link="front_rgbd_depth_optical_frame"/>
    <!-- body: +X forward,+Y left,+Z up; optical: +Z forward,+X right,+Y down -->
    <origin rpy="-1.571 0 -1.571" xyz="0.020 0 0"/>
  </joint>
  <gazebo reference="front_rgbd_link">
    <sensor name="front_rgbd_d435_rgbd" type="rgbd_camera">
