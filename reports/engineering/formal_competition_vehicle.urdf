  <!-- Rear bin shell hides the orthogonal dry/wet tank panels in normal
         operation.  The central pylon fairing turns the mast into a deliberate
         sensor spine without entering the MID-360 / GNSS keep-out volume. -->
  <link name="bodywork_rear_shell_link">
    <visual name="rear_bin_outer_shell_visual">
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/project/bodywork/rear_bin_outer_shell.stl"/>
      </geometry>
      <material name="body_warm_white">
        <color rgba="0.86 0.89 0.88 1"/>
      </material>
    </visual>
    <visual name="sensor_pylon_fairing_visual">
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/project/bodywork/sensor_pylon_fairing.stl"/>
      </geometry>
      <material name="sensor_pylon">
        <color rgba="0.070 0.085 0.088 1"/>
      </material>
    </visual>
    <visual name="sensor_pylon_service_hatch_visual">
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/project/bodywork/sensor_pylon_service_hatch.stl"/>
      </geometry>
      <material name="sensor_pylon_hatch">
        <color rgba="0.16 0.18 0.19 1"/>
      </material>
    </visual>
    <!-- Panelized collision follows the shell walls and deliberately leaves
           the robot-deposition aperture open; a solid cabinet-sized box would
           make a visually open hopper physically unusable. -->
    <collision name="rear_shell_rear_wall_collision">
      <origin xyz="-0.540 0 0.495"/>
      <geometry>
        <box size="0.045 0.70 0.52"/>
      </geometry>
    </collision>
    <!-- Thin moulded outer panels sit beyond the independent tank boards.
           Their inner faces retain 3.5 mm (dry) and 4 mm (wet) installation
           gaps instead of duplicating the internal walls with overlapping
           45 mm collision solids. -->
    <collision name="rear_shell_left_wall_collision">
      <origin xyz="-0.285 0.365 0.495"/>
      <geometry>
        <box size="0.53 0.020 0.52"/>
      </geometry>
    </collision>
    <collision name="rear_shell_right_wall_collision">
      <origin xyz="-0.285 -0.388 0.495"/>
      <geometry>
        <box size="0.53 0.020 0.52"/>
      </geometry>
    </collision>
    <!-- The moulded lower return is a perimeter frame, not a solid shelf.
           Keep its three load-bearing outer rails outside the dry / wet tank
           clear volumes so the robot chute remains a continuous gravity path
           to the real dry-bin floor. -->
    <collision name="rear_shell_lower_left_skirt_collision">
      <origin xyz="-0.285 0.365 0.275"/>
      <geometry>
        <box size="0.53 0.020 0.080"/>
      </geometry>
    </collision>
    <collision name="rear_shell_lower_right_skirt_collision">
      <origin xyz="-0.285 -0.388 0.275"/>
      <geometry>
        <box size="0.53 0.020 0.080"/>
      </geometry>
    </collision>
    <collision name="rear_shell_lower_rear_rail_collision">
      <origin xyz="-0.540 0 0.275"/>
      <geometry>
        <box size="0.045 0.70 0.080"/>
      </geometry>
    </collision>
    <collision name="rear_shell_roof_left_collision">
      <origin xyz="-0.285 0.310 0.735"/>
      <geometry>
        <box size="0.53 0.080 0.055"/>
      </geometry>
    </collision>
    <collision name="rear_shell_roof_right_collision">
      <origin xyz="-0.285 -0.255 0.735"/>
      <geometry>
        <box size="0.53 0.180 0.055"/>
      </geometry>
    </collision>
    <collision name="rear_shell_roof_front_collision">
      <origin xyz="-0.065 0.135 0.735"/>
      <geometry>
        <box size="0.090 0.270 0.055"/>
      </geometry>
    </collision>
    <collision name="rear_shell_roof_rear_collision">
      <origin xyz="-0.500 0.135 0.735"/>
      <geometry>
        <box size="0.080 0.270 0.055"/>
      </geometry>
    </collision>
    <collision name="pylon_fairing_rear_collision">
      <origin xyz="0.355 0 0.775"/>
      <geometry>
        <box size="0.030 0.220 0.350"/>
      </geometry>
    </collision>
    <!-- The front shroud stops below the UTM shelf instead of occupying
           the bracket.  Rear/side panels retain the 1.1151 m fairing top, so
           the declared 47 mm scan-plane clearance remains conservative. -->
    <collision name="pylon_fairing_front_collision">
      <origin xyz="0.485 0 0.7475"/>
      <geometry>
        <box size="0.030 0.220 0.295"/>
      </geometry>
    </collision>
    <collision name="pylon_fairing_right_collision">
      <origin xyz="0.420 -0.0775 0.775"/>
      <geometry>
        <box size="0.100 0.015 0.350"/>
      </geometry>
    </collision>
    <collision name="pylon_fairing_left_collision">
      <origin xyz="0.420 0.0775 0.775"/>
      <geometry>
        <box size="0.100 0.015 0.350"/>
      </geometry>
    </collision>
