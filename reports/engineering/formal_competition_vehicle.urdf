    <parent link="dry_deposit_hopper_link"/>
    <child link="dry_deposit_gate_actuator_link"/>
    <!-- The project CAD puts the XW540 output boss at local
           (0, -19.5, +12) mm.  Offset the housing so that this physical boss,
           the gate hinge and the moving horn are exactly coaxial at the
           closed-gate datum. -->
