      <inertia ixx="9.626426e-06" ixy="0" ixz="0" iyy="6.146512999999999e-06" iyz="0" izz="6.146512999999999e-06"/>
    </inertial>
  </link>
  <joint name="rear_right_fisheye_mount_joint" type="fixed">
    <parent link="rear_right_fisheye_mount_link"/>
    <child link="rear_right_fisheye_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="rear_right_fisheye_optical_frame">
    <!-- Optical frames are mathematical datums.  Epsilon inertia avoids a
           zero-inertia link in strict offline validation. -->
    <inertial>
      <mass value="0.000001"/>
      <inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/>
    </inertial>
  </link>
  <joint name="rear_right_fisheye_optical_frame_joint" type="fixed">
    <parent link="rear_right_fisheye_link"/>
    <child link="rear_right_fisheye_optical_frame"/>
    <!-- body: +X forward,+Y left,+Z up; optical: +Z forward,+X right,+Y down -->
    <origin rpy="-1.832595714594 -0.000035461162 -1.570996889205" xyz="0.022011096607 0.000604893394 -0.003891751553"/>
  </joint>
  <gazebo reference="rear_right_fisheye_link">
    <!-- Nominal simulation lens, not a serial-number camera calibration.
           SDFormat renders an equisolid-angle projection
             r = 2 f sin(theta / 2)
           while formal_fisheye_camera_info_publisher.py publishes the same
           mapping through ROS's equidistant (Kannala-Brandt) polynomial.  Its
           non-zero coefficients are the theta^9 Taylor representation
           of this exact SDF mapping.  The public M27195H15 source freezes only
           the 150 x 129 degree lens envelope; an as-built calibration remains
           mandatory before real-camera deployment. -->
    <sensor name="rear_right_fisheye_imx291" type="wideanglecamera">
      <topic>/sensors/rear_right_fisheye/image_raw</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <gz_frame_id>rear_right_fisheye_optical_frame</gz_frame_id>
      <camera>
        <optical_frame_id>rear_right_fisheye_optical_frame</optical_frame_id>
        <horizontal_fov>2.617994</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20.0</far>
        </clip>
        <lens>
          <type>equisolid_angle</type>
          <scale_to_hfov>true</scale_to_hfov>
          <cutoff_angle>1.570796327</cutoff_angle>
          <env_texture_size>1024</env_texture_size>
        </lens>
      </camera>
    </sensor>
  </gazebo>
  <!-- The GNSS installation is split into its real functional parts.  The
         ZED-F9P-04B LGA receiver sits in a serviceable mast-side enclosure;
         the ANN-MB antenna remains on a separate sky-view boom.  Gazebo's
         NavSat measurement datum stays at the antenna phase-centre link. -->
  <link name="zed_f9p_receiver_enclosure_link">
    <visual name="zed_f9p_receiver_enclosure_visual">
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/zed_f9p_receiver_enclosure.stl"/>
      </geometry>
      <material name="zed_f9p_receiver_tray">
        <color rgba="0.26 0.29 0.30 1"/>
      </material>
    </visual>
    <collision name="zed_f9p_receiver_enclosure_collision">
      <origin xyz="0 0 -0.002"/>
      <geometry>
        <box size="0.065 0.060 0.020"/>
      </geometry>
    </collision>
    <!-- The receiver hardware is split from the existing 0.240 kg GNSS
           mounting allocation, so this detail does not add fictitious mass. -->
    <inertial>
      <origin xyz="0 0 -0.002"/>
      <mass value="0.034999"/>
      <inertia ixx="1.1666333333333334e-05" ixy="0" ixz="0" iyy="1.348919791666667e-05" iyz="0" izz="2.2822264583333334e-05"/>
    </inertial>
  </link>
  <joint name="zed_f9p_receiver_enclosure_mount_joint" type="fixed">
    <parent link="sensor_mast_link"/>
    <child link="zed_f9p_receiver_enclosure_link"/>
    <origin xyz="-0.060 -0.095 0.585"/>
  </joint>
  <link name="zed_f9p_module_reference_link">
    <visual name="zed_f9p_module_reference_visual">
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/zed_f9p_module_reference.stl"/>
      </geometry>
      <material name="zed_f9p_module_shield">
        <color rgba="0.72 0.74 0.70 1"/>
      </material>
    </visual>
    <collision name="zed_f9p_official_package_collision">
      <geometry>
        <box size="0.017 0.022 0.0024"/>
      </geometry>
    </collision>
    <!-- u-blox does not publish a module mass in the selected public product
           material.  Epsilon mass preserves the explicit rigid body without
           inventing a hardware-correlated number; enclosure mass remains the
           conservative engineering allocation above. -->
    <inertial>
      <mass value="0.000001"/>
      <inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/>
    </inertial>
  </link>
