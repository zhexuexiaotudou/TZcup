  <gazebo reference="dry_deposit_chute_link">
    <sensor name="dry_deposit_contact" type="contact">
      <topic>/storage/dry_deposit/contact</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <!-- Fixed-joint reduction merges the chute into the actuated lid and
             prefixes the final SDF collision.  Reference that physics name so
             the acceptance contact topic contains real samples. -->
      <contact>
        <collision>dry_bin_lid_link_fixed_joint_lump__dry_deposit_chute_front_wall_collision_collision_8</collision>
      </contact>
    </sensor>
  </gazebo>
  <!-- Manual over-centre draw latch.  The base, moving hand lever and
         lid-mounted keeper are separate rigid bodies.  The handle joint is
         deliberately passive and state-only: opening it represents a human
         releasing the latch; no electric lid actuator is claimed.  URDF is a
         tree, so the engaged hook/keeper closed loop is represented by the
         zero-radian service interlock contract rather than a fake mimic joint. -->
  <link name="dry_bin_latch_base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
