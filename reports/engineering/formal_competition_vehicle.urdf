    <sensor name="zed_f9p" type="navsat">
      <topic>/sensors/gnss/fix</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>gnss_antenna_link</gz_frame_id>
      <!-- Gazebo NavSat horizontal noise is expressed in degrees. 9e-8 deg
             is approximately 1 cm at the equator, matching the RTK target. -->
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.00000009</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02</stddev>
            </noise>
          </vertical>
        </position_sensing>
