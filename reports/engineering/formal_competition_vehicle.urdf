  <!-- ROBOTIS DYNAMIXEL XW540-T260-R waterproof gate actuator. Its public
         33.5 x 58.5 x 45.9 mm, 0.185 kg envelope is hard-mounted outside the
         hopper; the coaxial output horn follows the gate. The commanded joint
         remains the physical gate hinge, so no fake closed kinematic loop is
         introduced into URDF. -->
  <link name="dry_deposit_gate_actuator_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://sanitation_vehicle_description/meshes/project/storage/dry_deposit_xw540_actuator.stl"/>
