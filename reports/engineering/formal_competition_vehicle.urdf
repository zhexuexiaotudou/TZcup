  <link name="front_rgbd_depth_optical_frame">
    <!-- Optical frames are mathematical datums.  Epsilon inertia avoids a
           zero-inertia link in strict offline validation. -->
    <inertial>
      <mass value="0.000001"/>
      <inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/>
