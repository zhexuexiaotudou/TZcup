  <joint name="rear_right_fisheye_bracket_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_fisheye_mount_link"/>
    <origin rpy="0 -0.175 -2.705" xyz="-0.565 -0.280 0.435"/>
  </joint>
  <link name="rear_right_fisheye_link">
    <visual name="rear_right_fisheye_rugged_housing_visual">
      <geometry>
