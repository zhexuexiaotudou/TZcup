ARG J6_ALGORITHM_BASE_IMAGE=tzcup/missing-j6-algorithm-base:blocked
FROM ${J6_ALGORITHM_BASE_IMAGE}

ARG ROS_SETUP
ARG RUNTIME_BACKEND=TRANSPORT_ONLY
USER root
RUN test -r "${ROS_SETUP}" && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      fastdds-tools iproute2 procps python3-colcon-common-extensions \
      python3-numpy python3-pip python3-yaml && \
    rm -rf /var/lib/apt/lists/*

RUN if [ "${RUNTIME_BACKEND}" = "PC_ONNX" ]; then \
      if python3 -m pip install --help 2>&1 | grep -q -- '--break-system-packages'; then \
        python3 -m pip install --break-system-packages --no-cache-dir onnxruntime==1.22.1; \
      else \
        python3 -m pip install --no-cache-dir onnxruntime==1.22.1; \
      fi; \
    elif [ "${RUNTIME_BACKEND}" = "TRANSPORT_ONLY" ] || \
         [ "${RUNTIME_BACKEND}" = "JOURNEY6_OE" ]; then \
      true; \
    else \
      echo "unsupported RUNTIME_BACKEND=${RUNTIME_BACKEND}" >&2; exit 2; \
    fi

WORKDIR /opt/tzcup_ws
COPY starter_ws/src/sanitation_perception/ src/sanitation_perception/
COPY starter_ws/src/journey6_hil_gateway/ src/journey6_hil_gateway/
COPY scripts/j6_hil_network_faults.py /opt/tzcup/bin/j6_hil_network_faults.py

RUN /bin/bash -c "source '${ROS_SETUP}' && colcon build \
      --merge-install \
      --packages-select sanitation_perception journey6_hil_gateway"

ENV TZCUP_ROS_SETUP=${ROS_SETUP} \
    TZCUP_WS_SETUP=/opt/tzcup_ws/install/setup.bash \
    TZCUP_RUNTIME_BACKEND=${RUNTIME_BACKEND} \
    PYTHONUNBUFFERED=1

RUN mkdir -p /evidence /opt/tzcup/runtime /opt/tzcup/models /opt/tzcup/config && \
    chmod 0555 /opt/tzcup/bin/j6_hil_network_faults.py

CMD ["/bin/bash", "-lc", "source \"${TZCUP_ROS_SETUP}\" && source \"${TZCUP_WS_SETUP}\" && exec ros2 run journey6_hil_gateway journey6_hil_gateway"]
