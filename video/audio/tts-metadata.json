                         "speech_duration_sec":  3.043,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "国产系统无人清扫车"
                     },
                     {
                         "id":  "002",
                         "start_sec":  4,
                         "end_sec":  8,
                         "speech_duration_sec":  3.569,
                         "lead_silence_ms":  215,
                         "tts_rate":  1,
                         "speech":  "感知、机械臂、清扫一体化"
                     },
                     {
                         "id":  "003",
                         "start_sec":  8,
                         "end_sec":  12,
                         "speech_duration_sec":  3.56,
                         "lead_silence_ms":  220,
                         "tts_rate":  2,
                         "speech":  "面向智慧环卫场景的自主作业平台"
                     },
                     {
                         "id":  "004",
                         "start_sec":  12,
                         "end_sec":  20,
                         "speech_duration_sec":  7.484,
                         "lead_silence_ms":  258,
                         "tts_rate":  2,
                         "speech":  "整车从结构建模起步。四轮驱动底盘和上装模块在同一数字模型中完成集成。"
                     },
                     {
                         "id":  "005",
                         "start_sec":  20,
                         "end_sec":  28,
                         "speech_duration_sec":  7.622,
                         "lead_silence_ms":  189,
                         "tts_rate":  0,
                         "speech":  "车体下方布置双扫盘、滚刷和密封尘箱，构成连续清扫基础。"
                     },
                     {
                         "id":  "006",
                         "start_sec":  28,
                         "end_sec":  36,
                         "speech_duration_sec":  7.002,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "车顶安装多关节机械臂与传感支架，兼顾抓取、感知与收纳。"
                     },
                     {
                         "id":  "007",
                         "start_sec":  36,
                         "end_sec":  44,
                         "speech_duration_sec":  7.166,
                         "lead_silence_ms":  350,
                         "tts_rate":  1,
                         "speech":  "激光雷达、深度相机、惯性测量单元和卫星定位模块协同感知环境。"
                     },
                     {
                         "id":  "008",
                         "start_sec":  44,
                         "end_sec":  52,
                         "speech_duration_sec":  6.038,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "清扫、抓取、运动与安全状态统一纳入控制架构。"
                     },
                     {
                         "id":  "009",
                         "start_sec":  52,
                         "end_sec":  60,
                         "speech_duration_sec":  6.782,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "模块化设计让整车结构清晰，也方便算法迭代与功能扩展。"
                     },
                     {
                         "id":  "010",
                         "start_sec":  60,
                         "end_sec":  68,
                         "speech_duration_sec":  3.998,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "进入功能演示，先看基础运动。"
                     },
                     {
                         "id":  "011",
                         "start_sec":  68,
                         "end_sec":  78,
                         "speech_duration_sec":  7.182,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "四轮驱动底盘保持平顺速度，完成直线、转弯和路径跟踪。"
                     },
                     {
                         "id":  "012",
                         "start_sec":  78,
                         "end_sec":  88,
                         "speech_duration_sec":  6.737,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "这段画面连续跟踪两个导航目标，路线稳定，终点清晰。"
                     },
                     {
                         "id":  "013",
                         "start_sec":  88,
                         "end_sec":  95,
                         "speech_duration_sec":  6.607,
                         "lead_silence_ms":  196,
                         "tts_rate":  0,
                         "speech":  "底盘位姿与速度保持一致，为清扫和抓取提供稳定平台。"
                     },
                     {
                         "id":  "014",
                         "start_sec":  95,
                         "end_sec":  104,
                         "speech_duration_sec":  3.588,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "接下来展示机械臂抓取动作。"
                     },
                     {
                         "id":  "015",
                         "start_sec":  104,
                         "end_sec":  114,
                         "speech_duration_sec":  6.282,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "机械臂从待机姿态展开，各关节沿规划轨迹平稳运动。"
                     },
                     {
                         "id":  "016",
                         "start_sec":  114,
                         "end_sec":  124,
                         "speech_duration_sec":  6.392,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "末端执行器完成对准、夹持与抬升，动作衔接自然。"
                     },
                     {
                         "id":  "017",
                         "start_sec":  124,
                         "end_sec":  130,
                         "speech_duration_sec":  5.514,
                         "lead_silence_ms":  243,
                         "tts_rate":  1,
                         "speech":  "目标被稳定送入车体尘箱，完成抓取收纳基础流程。"
                     },
                     {
                         "id":  "018",
                         "start_sec":  130,
                         "end_sec":  138,
                         "speech_duration_sec":  3.763,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "现在把感知与抓取串联起来。"
                     },
                     {
                         "id":  "019",
                         "start_sec":  138,
                         "end_sec":  148,
                         "speech_duration_sec":  7.157,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "激光雷达与视觉先建立作业区域，识别地面杂物并输出目标位置。"
                     },
                     {
                         "id":  "020",
                         "start_sec":  148,
                         "end_sec":  158,
                         "speech_duration_sec":  6.677,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "车辆根据目标位置平稳接近，路径顺畅，姿态持续可控。"
                     },
                     {
                         "id":  "021",
                         "start_sec":  158,
                         "end_sec":  168,
                         "speech_duration_sec":  7.087,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "到达目标后，机械臂伸出并对准杂物，夹爪完成锁定与抓取。"
                     },
                     {
                         "id":  "022",
                         "start_sec":  168,
                         "end_sec":  180,
                         "speech_duration_sec":  7.277,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "抓取后的杂物被送回尘箱，移动、感知与收纳形成完整作业链。"
                     },
                     {
                         "id":  "023",
                         "start_sec":  180,
                         "end_sec":  188,
                         "speech_duration_sec":  5.058,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "面对路面积水，系统切换湿式清洁模式。"
                     },
                     {
                         "id":  "024",
                         "start_sec":  188,
                         "end_sec":  198,
                         "speech_duration_sec":  6.072,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "泵阀与刷盘协同工作，车辆沿水渍区域平稳通过。"
                     },
                     {
                         "id":  "025",
                         "start_sec":  198,
                         "end_sec":  207,
                         "speech_duration_sec":  4.068,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "水迹逐步收束，地面恢复整洁。"
                     },
                     {
                         "id":  "026",
                         "start_sec":  207,
                         "end_sec":  220,
                         "speech_duration_sec":  6.607,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "干式清扫与湿式清洁共用同一底盘，作业模式灵活切换。"
                     },
                     {
                         "id":  "027",
                         "start_sec":  220,
                         "end_sec":  228,
                         "speech_duration_sec":  3.248,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "进入环境建图成果展示。"
                     },
                     {
                         "id":  "028",
                         "start_sec":  228,
                         "end_sec":  239,
                         "speech_duration_sec":  7.636,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "园区环境建模结果覆盖约两万两千四百平方米，整体规模完整呈现。"
                     },
                     {
                         "id":  "029",
                         "start_sec":  239,
                         "end_sec":  250,
                         "speech_duration_sec":  8.237,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "地图分辨率为五厘米，道路、建筑、障碍边界与可通行区域清晰表达。"
                     },
                     {
                         "id":  "030",
                         "start_sec":  250,
                         "end_sec":  260,
                         "speech_duration_sec":  6.067,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "统一地图为定位、规划和覆盖路径提供稳定空间基准。"
                     },
                     {
                         "id":  "031",
                         "start_sec":  260,
                         "end_sec":  268,
                         "speech_duration_sec":  3.918,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "最后展示清扫作业与安全响应。"
                     },
                     {
                         "id":  "032",
                         "start_sec":  268,
                         "end_sec":  279,
                         "speech_duration_sec":  7.237,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "车辆沿规划路径平稳前进，双扫盘和滚刷贴近地面持续工作。"
                     },
                     {
                         "id":  "033",
                         "start_sec":  279,
                         "end_sec":  286,
                         "speech_duration_sec":  5.732,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "中央连续清除带达到六百毫米，清扫覆盖清晰。"
                     },
                     {
                         "id":  "034",
                         "start_sec":  286,
                         "end_sec":  296,
                         "speech_duration_sec":  7.727,
                         "lead_silence_ms":  350,
                         "tts_rate":  0,
                         "speech":  "行驶中急停响应时间为仿真零点四八九秒，车辆稳定进入停止状态。"
                     },
