<?xml version="1.0"?>
<sdf version="1.10">
  <model name="formal_physical_service_station">
    <static>true</static>
    <!-- Coordinates assume the formal vehicle is spawned at the origin. The
         fixture bodies overlap only the dedicated receptacle/coupling collars. -->
    <link name="charge_plug_fixture_link">
      <pose>0.250 0.430 0.4831 1.570796327 0 0</pose>
      <visual name="charge_plug_fixture_visual">
        <geometry><cylinder><radius>0.018</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.04 0.20 0.32 1</ambient><diffuse>0.05 0.30 0.48 1</diffuse></material>
      </visual>
      <collision name="charge_plug_fixture_collision">
        <geometry><cylinder><radius>0.018</radius><length>0.050</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="wastewater_hose_fixture_link">
      <pose>-0.555 -0.305 0.5101 0 0 0</pose>
      <visual name="wastewater_hose_fixture_visual">
        <geometry><cylinder><radius>0.018</radius><length>0.060</length></cylinder></geometry>
        <material><ambient>0.03 0.035 0.04 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material>
      </visual>
      <collision name="wastewater_hose_fixture_collision">
        <geometry><cylinder><radius>0.018</radius><length>0.060</length></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="service_station_marker_link">
      <pose>-0.15 0.78 0.35 0 0 0</pose>
      <visual name="service_station_marker_visual">
        <geometry><box><size>0.70 0.05 0.70</size></box></geometry>
        <material><ambient>0.75 0.58 0.08 0.35</ambient><diffuse>0.90 0.70 0.10 0.35</diffuse></material>
        <transparency>0.65</transparency>
      </visual>
    </link>
  </model>
</sdf>
