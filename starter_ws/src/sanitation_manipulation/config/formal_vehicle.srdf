<?xml version="1.0"?>
<robot name="tzcup_formal_sanitation_vehicle">
  <!-- The mobile base is localized in map; manipulator remains arm-only. -->
  <virtual_joint name="formal_world_joint" type="planar" parent_frame="map" child_link="base_footprint"/>
  <group name="manipulator">
    <chain base_link="ur5e_base_link" tip_link="tool0"/>
  </group>
  <group name="gripper">
    <joint name="robotiq_85_left_knuckle_joint"/>
  </group>
  <end_effector name="robotiq_2f85" parent_link="tool0" group="gripper" parent_group="manipulator"/>
  <group_state name="transport" group="manipulator">
    <joint name="shoulder_pan_joint" value="-1.0"/>
    <joint name="shoulder_lift_joint" value="-1.0"/>
    <joint name="elbow_joint" value="1.8"/>
    <joint name="wrist_1_joint" value="-1.5"/>
    <joint name="wrist_2_joint" value="-1.55"/>
    <joint name="wrist_3_joint" value="0.25"/>
  </group_state>
  <disable_collisions link1="ur5e_base_link" link2="ur5e_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="ur5e_base_link_inertia" link2="ur5e_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="ur5e_shoulder_link" link2="ur5e_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="ur5e_upper_arm_link" link2="ur5e_forearm_link" reason="Adjacent"/>
  <disable_collisions link1="ur5e_forearm_link" link2="ur5e_wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="ur5e_wrist_1_link" link2="ur5e_wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="ur5e_wrist_2_link" link2="ur5e_wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="ur5e_wrist_3_link" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="ur_to_robotiq_adapter_link" reason="Adjacent"/>
  <disable_collisions link1="ur_to_robotiq_adapter_link" link2="robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
</robot>
