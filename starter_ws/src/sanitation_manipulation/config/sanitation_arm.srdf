<?xml version="1.0"?>
<robot name="sanitation_vehicle">
  <group name="manipulator">
    <chain base_link="arm_mount_link" tip_link="gripper_palm_link"/>
  </group>
  <group name="gripper">
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>
  <end_effector name="sanitation_gripper" parent_link="gripper_palm_link" group="gripper" parent_group="manipulator"/>
  <disable_collisions link1="arm_base_link" link2="arm_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="arm_shoulder_link" link2="arm_elbow_link" reason="Adjacent"/>
  <disable_collisions link1="arm_elbow_link" link2="arm_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_link" link2="gripper_palm_link" reason="Adjacent"/>
</robot>
