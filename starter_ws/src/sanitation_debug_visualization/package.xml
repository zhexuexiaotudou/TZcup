<?xml version="1.0"?>
<package format="3">
  <name>sanitation_debug_visualization</name>
  <version>0.1.0</version>
  <description>Operator-facing RViz debug visualization for the sanitation simulation.</description>
  <maintainer email="team@example.com">Sanitation Vehicle Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sanitation_bringup</exec_depend>
  <exec_depend>sanitation_ground_truth</exec_depend>
  <exec_depend>sanitation_perception</exec_depend>
  <exec_depend>sanitation_perception_interfaces</exec_depend>
  <exec_depend>sanitation_tasks</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
