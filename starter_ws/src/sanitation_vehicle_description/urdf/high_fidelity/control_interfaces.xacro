<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ros2_control contracts are separated from link geometry so that the same
       assembly can be expanded for RViz, Gazebo or a hardware adapter. -->
  <xacro:macro name="hf_position_joint" params="name lower upper velocity effort initial_position:=0.0">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="hf_velocity_joint" params="name max_velocity max_effort">
    <joint name="${name}">
      <command_interface name="velocity">
        <param name="min">${-max_velocity}</param>
        <param name="max">${max_velocity}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="hf_state_only_joint" params="name initial_position:=0.0">
    <joint name="${name}">
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="hf_formal_ros2_control" params="use_sim:=true">
    <ros2_control name="formal_vehicle_system" type="system">
      <hardware>
        <xacro:if value="${use_sim}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_sim}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>
      </hardware>

      <!-- A300DrivetrainPlantSystem is the sole four-wheel effort writer.
           ros2_control exports measured state only; a velocity command
           interface here would create a second physical command authority. -->
      <xacro:hf_state_only_joint name="front_left_wheel_joint"/>
      <xacro:hf_state_only_joint name="front_right_wheel_joint"/>
      <xacro:hf_state_only_joint name="rear_left_wheel_joint"/>
      <xacro:hf_state_only_joint name="rear_right_wheel_joint"/>

      <!-- Gazebo must start in the same frozen transport posture used by the
           swept-volume, FOV and manipulation contracts.  A zero pose places
           the extended arm directly across the forward RGBD camera. -->
      <xacro:hf_position_joint name="shoulder_pan_joint" lower="${-2*pi}" upper="${2*pi}" velocity="3.14" effort="150.0" initial_position="-1.0"/>
      <xacro:hf_position_joint name="shoulder_lift_joint" lower="${-2*pi}" upper="${2*pi}" velocity="3.14" effort="150.0" initial_position="-1.0"/>
      <xacro:hf_position_joint name="elbow_joint" lower="${-pi}" upper="${pi}" velocity="3.14" effort="150.0" initial_position="1.8"/>
      <xacro:hf_position_joint name="wrist_1_joint" lower="${-2*pi}" upper="${2*pi}" velocity="3.14" effort="28.0" initial_position="-1.5"/>
      <xacro:hf_position_joint name="wrist_2_joint" lower="${-2*pi}" upper="${2*pi}" velocity="3.14" effort="28.0" initial_position="-1.55"/>
      <xacro:hf_position_joint name="wrist_3_joint" lower="${-2*pi}" upper="${2*pi}" velocity="3.14" effort="28.0" initial_position="0.25"/>
      <xacro:hf_position_joint name="robotiq_85_left_knuckle_joint" lower="0.0" upper="0.8" velocity="0.5" effort="50.0" initial_position="0.20"/>
      <!-- The real 2F-85 has one commanded actuator.  DART cannot create the
           URDF mimic constraints, so GripperMimicEffortSystem is the sole
           effort writer for these five passive linkage joints.  Export their
           measured state to make the linkage error a mandatory runtime
           acceptance signal without inventing five additional actuators. -->
      <xacro:hf_state_only_joint name="robotiq_85_right_knuckle_joint" initial_position="-0.20"/>
      <xacro:hf_state_only_joint name="robotiq_85_left_inner_knuckle_joint" initial_position="0.20"/>
      <xacro:hf_state_only_joint name="robotiq_85_right_inner_knuckle_joint" initial_position="-0.20"/>
      <xacro:hf_state_only_joint name="robotiq_85_left_finger_tip_joint" initial_position="-0.20"/>
      <xacro:hf_state_only_joint name="robotiq_85_right_finger_tip_joint" initial_position="0.20"/>

      <xacro:hf_velocity_joint name="left_side_brush_joint" max_velocity="14.660766" max_effort="3.040473"/>
      <xacro:hf_velocity_joint name="right_side_brush_joint" max_velocity="14.660766" max_effort="3.040473"/>
      <xacro:hf_velocity_joint name="central_roller_joint" max_velocity="14.660766" max_effort="3.040473"/>
      <xacro:hf_velocity_joint name="recovery_pump_joint" max_velocity="62.832" max_effort="2.0"/>
      <!-- Physical zero is the controller-independent safe raised pose;
           positive command moves downward to the 0.100 m work position. -->
      <xacro:hf_position_joint name="cleaning_lift_joint" lower="0.0" upper="0.100" velocity="0.0048" effort="300.0" initial_position="0.0"/>
      <!-- The two squeegee axes are passive: Gazebo's compliance plugin is
           their only effort writer. Export measured state for physical
           acceptance without exposing a ros2_control command interface. -->
      <xacro:hf_state_only_joint name="squeegee_float_joint"/>
      <xacro:hf_state_only_joint name="squeegee_pitch_joint"/>
      <xacro:hf_position_joint name="dry_deposit_gate_joint" lower="0.0" upper="1.75" velocity="0.8" effort="9.5"/>
      <!-- 24 V spring-return normally-closed drain actuator.  Charge door,
           charge lock, E-stop plunger and service lids are passive joints and
           intentionally have no ros2_control command interface. -->
      <xacro:hf_position_joint name="wastewater_drain_valve_joint" lower="0.0" upper="${pi/2.0}" velocity="1.2" effort="25.0"/>
      <!-- Passive service hardware is not commandable, but its measured
           position must reach joint_state_broadcaster for physical interlocks. -->
      <xacro:hf_state_only_joint name="charge_port_door_hinge_joint"/>
      <xacro:hf_state_only_joint name="charge_connector_lock_joint"/>
      <xacro:hf_state_only_joint name="emergency_stop_plunger_joint" initial_position="0.00002"/>
      <!-- Keep passive switchgear a small measured clearance off the exact
           hard stop.  DART otherwise treats a joint initialized exactly at
           its lower limit as a locked unilateral constraint even when the
           physical plugin applies torque / force away from that stop.  Both
           clearances remain far below their electrical closed thresholds. -->
      <xacro:hf_state_only_joint name="main_power_isolator_handle_joint" initial_position="0.002"/>
      <xacro:hf_state_only_joint name="main_power_contactor_armature_joint" initial_position="0.00002"/>
      <xacro:hf_state_only_joint name="wastewater_drain_service_cap_joint"/>
      <!-- Compartment lids and over-centre latch handles are human-operated.
           Export measured state for maintenance interlocks without exposing a
           command interface or implying powered bin lids. -->
      <xacro:hf_state_only_joint name="dry_bin_lid_joint"/>
      <xacro:hf_state_only_joint name="dry_bin_latch_joint"/>
      <xacro:hf_state_only_joint name="wastewater_lid_joint"/>
      <xacro:hf_state_only_joint name="wastewater_lid_latch_joint"/>
      <!-- Four manually latched body service doors remain passive mechanisms.
           Export hinge and rotary-latch state so service tooling can prove a
           panel is unlocked/open without inventing powered door actuators. -->
      <xacro:hf_state_only_joint name="bodywork_power_service_door_hinge_joint"/>
      <xacro:hf_state_only_joint name="bodywork_power_service_door_latch_joint"/>
      <xacro:hf_state_only_joint name="bodywork_compute_service_door_hinge_joint"/>
      <xacro:hf_state_only_joint name="bodywork_compute_service_door_latch_joint"/>
      <xacro:hf_state_only_joint name="bodywork_wet_service_door_hinge_joint"/>
      <xacro:hf_state_only_joint name="bodywork_wet_service_door_latch_joint"/>
      <xacro:hf_state_only_joint name="bodywork_rear_dry_service_door_hinge_joint"/>
      <xacro:hf_state_only_joint name="bodywork_rear_dry_service_door_latch_joint"/>
    </ros2_control>
  </xacro:macro>
</robot>
