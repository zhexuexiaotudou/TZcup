<?xml version="1.0"?>
<!--
  Product exterior for the formal competition vehicle.

  The bodywork is deliberately separate from the functional A300, storage,
  cleaning and manipulation links.  Normal operation shows the moulded shell;
  bodywork_visible:=false removes only visual elements for service teaching.
  Collision and inertial properties remain identical in both modes.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="hf_body_mesh_root"
                  value="package://sanitation_vehicle_description/meshes/project/bodywork"/>

  <xacro:macro name="hf_bodywork_box_inertial" params="mass sx sy sz xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (sy*sy + sz*sz) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (sx*sx + sz*sz) / 12.0}" iyz="0"
        izz="${mass * (sx*sx + sy*sy) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="hf_body_visual" params="mesh material rgba visible">
    <xacro:if value="${visible}">
      <visual name="${mesh.replace('.stl', '')}_visual">
        <geometry><mesh filename="${hf_body_mesh_root}/${mesh}"/></geometry>
        <material name="${material}"><color rgba="${rgba}"/></material>
      </visual>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="hf_service_door"
               params="name parent mesh material rgba door_mass size cog collision_xyz hinge_xyz hinge_height lower upper latch_xyz latch_axis hinge_rpy:='0 0 0' latch_rpy:='0 0 0' visible:=true">
    <link name="${name}_hinge_bracket_link">
      <xacro:if value="${visible}">
        <visual name="${name}_lower_hinge_visual">
          <origin xyz="0 0 0.035" rpy="${hinge_rpy}"/>
          <geometry><mesh filename="${hf_body_mesh_root}/service_door_hinge_barrel.stl"/></geometry>
          <material name="${name}_hinge_zinc"><color rgba="0.32 0.35 0.36 1"/></material>
        </visual>
        <visual name="${name}_upper_hinge_visual">
          <origin xyz="0 0 ${hinge_height - 0.035}" rpy="${hinge_rpy}"/>
          <geometry><mesh filename="${hf_body_mesh_root}/service_door_hinge_barrel.stl"/></geometry>
          <material name="${name}_hinge_zinc_upper"><color rgba="0.32 0.35 0.36 1"/></material>
        </visual>
      </xacro:if>
      <collision name="${name}_lower_hinge_collision">
        <origin xyz="0 0 0.035"/><geometry><cylinder radius="0.008" length="0.050"/></geometry>
      </collision>
      <collision name="${name}_upper_hinge_collision">
        <origin xyz="0 0 ${hinge_height - 0.035}"/><geometry><cylinder radius="0.008" length="0.050"/></geometry>
      </collision>
      <xacro:hf_bodywork_box_inertial mass="0.030" sx="0.028" sy="0.020" sz="${hinge_height}" xyz="0 0 ${hinge_height/2.0}"/>
    </link>
    <joint name="${name}_hinge_bracket_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}_hinge_bracket_link"/>
      <origin xyz="${hinge_xyz}" rpy="0 0 0"/>
    </joint>

    <link name="${name}_link">
      <xacro:hf_body_visual mesh="${mesh}" material="${material}" rgba="${rgba}" visible="${visible}"/>
      <collision name="${name}_collision">
        <origin xyz="${collision_xyz}" rpy="0 0 0"/>
        <geometry><box size="${size}"/></geometry>
      </collision>
      <xacro:hf_bodywork_box_inertial
        mass="${door_mass}"
        sx="${float(size.split()[0])}"
        sy="${float(size.split()[1])}"
        sz="${float(size.split()[2])}"
        xyz="${cog}"/>
    </link>
    <joint name="${name}_hinge_joint" type="revolute">
      <parent link="${name}_hinge_bracket_link"/><child link="${name}_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${lower}" upper="${upper}" effort="30.0" velocity="0.5"/>
      <dynamics damping="2.5" friction="4.0"/>
    </joint>

    <link name="${name}_latch_link">
      <xacro:if value="${visible}">
        <visual name="${name}_rotary_latch_visual">
          <origin xyz="0 0 0" rpy="${latch_rpy}"/>
          <geometry><mesh filename="${hf_body_mesh_root}/service_door_rotary_latch.stl"/></geometry>
          <material name="${name}_latch_black"><color rgba="0.055 0.065 0.068 1"/></material>
        </visual>
      </xacro:if>
      <collision name="${name}_rotary_latch_collision">
        <origin xyz="0 0 0" rpy="${latch_rpy}"/><geometry><box size="0.045 0.020 0.018"/></geometry>
      </collision>
      <xacro:hf_bodywork_box_inertial mass="0.025" sx="0.045" sy="0.020" sz="0.018"/>
    </link>
    <joint name="${name}_latch_joint" type="revolute">
      <parent link="${name}_link"/><child link="${name}_latch_link"/>
      <origin xyz="${latch_xyz}" rpy="0 0 0"/>
      <axis xyz="${latch_axis}"/>
      <limit lower="-0.785398163" upper="0.785398163" effort="8.0" velocity="1.0"/>
      <dynamics damping="0.8" friction="1.5"/>
    </joint>
  </xacro:macro>

  <!-- Dedicated, inertially negligible frames make service and safety feature
       datums machine-verifiable.  The visible meshes remain grouped for
       rendering efficiency, but the register no longer points at an aggregate
       bodywork link whose origin says nothing about the individual feature. -->
  <xacro:macro name="hf_bodywork_datum" params="name parent xyz rpy:='0 0 0'">
    <link name="${name}_datum_link">
      <inertial><mass value="0.000001"/><inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/></inertial>
    </link>
    <joint name="${name}_datum_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}_datum_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="hf_product_bodywork" params="parent visible:=true">
    <!-- Lower graphite bath-tub body.  Central underside remains open for the
         roller and rear recovery mechanism, while four radial arch meshes keep
         13 mm visual clearance over the 330.2 mm tyres. -->
    <link name="bodywork_lower_tub_link">
      <xacro:hf_body_visual mesh="lower_tub_left.stl" material="body_graphite" rgba="0.055 0.065 0.070 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="lower_tub_right.stl" material="body_graphite" rgba="0.055 0.065 0.070 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="side_skirt_left.stl" material="body_skirt" rgba="0.025 0.030 0.032 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="side_skirt_right.stl" material="body_skirt" rgba="0.025 0.030 0.032 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="wheel_arch_front_left.stl" material="wheel_arch" rgba="0.075 0.082 0.085 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="wheel_arch_front_right.stl" material="wheel_arch" rgba="0.075 0.082 0.085 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="wheel_arch_rear_left.stl" material="wheel_arch" rgba="0.075 0.082 0.085 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="wheel_arch_rear_right.stl" material="wheel_arch" rgba="0.075 0.082 0.085 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="front_bumper.stl" material="bumper_epdm" rgba="0.018 0.022 0.024 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="rear_bumper.stl" material="bumper_epdm" rgba="0.018 0.022 0.024 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="rear_squeegee_valance.stl" material="rear_valance" rgba="0.035 0.045 0.048 1" visible="${visible}"/>
      <collision name="left_lower_tub_collision"><origin xyz="0 0.245 0.135"/><geometry><box size="1.00 0.235 0.220"/></geometry></collision>
      <collision name="right_lower_tub_collision"><origin xyz="0 -0.245 0.135"/><geometry><box size="1.00 0.235 0.220"/></geometry></collision>
      <collision name="front_bumper_collision"><origin xyz="0.555 0 0.105"/><geometry><box size="0.055 0.660 0.070"/></geometry></collision>
      <collision name="rear_bumper_collision"><origin xyz="-0.555 0 0.105"/><geometry><box size="0.060 0.700 0.075"/></geometry></collision>
      <xacro:hf_bodywork_box_inertial mass="3.80" sx="1.11" sy="0.74" sz="0.25" xyz="0 0 0.145"/>
    </link>
    <joint name="bodywork_lower_tub_joint" type="fixed"><parent link="${parent}"/><child link="bodywork_lower_tub_link"/></joint>
    <gazebo reference="bodywork_lower_tub_link">
      <sensor name="front_safety_bumper_contact" type="contact">
        <topic>/safety/front_bumper/contact</topic><update_rate>200</update_rate><always_on>true</always_on>
        <contact><collision>front_bumper_collision</collision></contact>
      </sensor>
      <sensor name="rear_safety_bumper_contact" type="contact">
        <topic>/safety/rear_bumper/contact</topic><update_rate>200</update_rate><always_on>true</always_on>
        <contact><collision>rear_bumper_collision</collision></contact>
      </sensor>
    </gazebo>

    <!-- Warm-white moulded nose and asymmetric equipment fairings.  The arm
         shoulder remains open above the right cowl. -->
    <link name="bodywork_front_cowl_link">
      <xacro:hf_body_visual mesh="front_center_nose.stl" material="body_warm_white" rgba="0.86 0.89 0.88 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="front_left_power_cowl.stl" material="body_warm_white" rgba="0.86 0.89 0.88 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="front_right_compute_cowl.stl" material="body_warm_white" rgba="0.86 0.89 0.88 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="arm_turret_shoulder.stl" material="arm_turret" rgba="0.045 0.055 0.058 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="arm_bay_floor.stl" material="arm_bay_floor" rgba="0.055 0.070 0.073 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="arm_bay_outer_sill.stl" material="arm_bay_sill" rgba="0.075 0.090 0.092 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="arm_bay_inner_sill.stl" material="arm_bay_sill" rgba="0.075 0.090 0.092 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="arm_bay_front_sill.stl" material="arm_bay_sill" rgba="0.075 0.090 0.092 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="arm_bay_rear_sill.stl" material="arm_bay_sill" rgba="0.075 0.090 0.092 1" visible="${visible}"/>
      <collision name="nose_outer_lobe_collision"><origin xyz="0.3975 -0.2125 0.280"/><geometry><box size="0.315 0.245 0.20"/></geometry></collision>
      <collision name="nose_inner_lobe_collision"><origin xyz="0.3975 0.2125 0.280"/><geometry><box size="0.315 0.245 0.20"/></geometry></collision>
      <collision name="nose_rear_bridge_collision"><origin xyz="0.2775 0 0.280"/><geometry><box size="0.075 0.67 0.20"/></geometry></collision>
      <collision name="nose_front_bridge_collision"><origin xyz="0.5400 0 0.280"/><geometry><box size="0.030 0.67 0.20"/></geometry></collision>
      <!-- Keep the aft face ahead of the dry-bin front panel.  The former
           490 mm box entered the certified dry usable envelope by 2.5 mm. -->
      <collision name="power_cowl_collision"><origin xyz="0.290 0.235 0.535"/><geometry><box size="0.470 0.29 0.48"/></geometry></collision>
      <!-- The compute enclosure moved to the control-cabinet roof.  This is
           now a low outboard sill, leaving the arm a real open egress lane. -->
      <collision name="arm_egress_outer_sill_collision"><origin xyz="0.370 -0.405 0.150"/><geometry><box size="0.270 0.070 0.120"/></geometry></collision>
      <!-- Panelized arm bay and turret: the former monolithic floor and cowl
           boxes occupied the official UR5e base.  These eight real members
           retain a load-bearing U-shaped tray while leaving a 164 mm clear
           base aperture around the 151 mm vendor collision mesh. -->
      <!-- No rear floor rail: that volume is occupied by the independently
           sealed dry/wet vessels.  The arm backing plate carries the rear
           load into the deck without entering either certified fill volume. -->
      <collision name="arm_bay_floor_front_collision"><origin xyz="0.3625 -0.245 0.335"/><geometry><box size="0.245 0.320 0.110"/></geometry></collision>
      <collision name="arm_bay_floor_outer_collision"><origin xyz="0.135 -0.3725 0.335"/><geometry><box size="0.210 0.065 0.110"/></geometry></collision>
      <collision name="arm_bay_floor_inner_collision"><origin xyz="0.100 -0.090 0.335"/><geometry><box size="0.280 0.050 0.110"/></geometry></collision>
      <collision name="arm_turret_rear_collision"><origin xyz="-0.0025 -0.200 0.315"/><geometry><box size="0.035 0.280 0.160"/></geometry></collision>
      <collision name="arm_turret_front_collision"><origin xyz="0.2025 -0.200 0.315"/><geometry><box size="0.035 0.280 0.160"/></geometry></collision>
      <collision name="arm_turret_outer_collision"><origin xyz="0.100 -0.325 0.315"/><geometry><box size="0.170 0.030 0.160"/></geometry></collision>
      <collision name="arm_turret_inner_collision"><origin xyz="0.100 -0.075 0.315"/><geometry><box size="0.170 0.030 0.160"/></geometry></collision>
      <xacro:hf_bodywork_box_inertial mass="3.40" sx="0.58" sy="0.72" sz="0.55" xyz="0.26 0.06 0.43"/>
    </link>
    <joint name="bodywork_front_cowl_joint" type="fixed"><parent link="${parent}"/><child link="bodywork_front_cowl_link"/></joint>

    <!-- Rear bin shell hides the orthogonal dry/wet tank panels in normal
         operation.  The central pylon fairing turns the mast into a deliberate
         sensor spine without entering the MID-360 / GNSS keep-out volume. -->
    <link name="bodywork_rear_shell_link">
      <xacro:hf_body_visual mesh="rear_bin_outer_shell.stl" material="body_warm_white" rgba="0.86 0.89 0.88 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="sensor_pylon_fairing.stl" material="sensor_pylon" rgba="0.070 0.085 0.088 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="sensor_pylon_service_hatch.stl" material="sensor_pylon_hatch" rgba="0.16 0.18 0.19 1" visible="${visible}"/>
      <!-- Panelized collision follows the shell walls and deliberately leaves
           the robot-deposition aperture open; a solid cabinet-sized box would
           make a visually open hopper physically unusable. -->
      <collision name="rear_shell_rear_wall_collision"><origin xyz="-0.540 0 0.495"/><geometry><box size="0.045 0.70 0.52"/></geometry></collision>
      <!-- Thin moulded outer panels sit beyond the independent tank boards.
           Their inner faces retain 3.5 mm (dry) and 4 mm (wet) installation
           gaps instead of duplicating the internal walls with overlapping
           45 mm collision solids. -->
      <collision name="rear_shell_left_wall_collision"><origin xyz="-0.285 0.365 0.495"/><geometry><box size="0.53 0.020 0.52"/></geometry></collision>
      <collision name="rear_shell_right_wall_collision"><origin xyz="-0.285 -0.388 0.495"/><geometry><box size="0.53 0.020 0.52"/></geometry></collision>
      <!-- The moulded lower return is a perimeter frame, not a solid shelf.
           Keep its three load-bearing outer rails outside the dry / wet tank
           clear volumes so the robot chute remains a continuous gravity path
           to the real dry-bin floor. -->
      <collision name="rear_shell_lower_left_skirt_collision"><origin xyz="-0.285 0.365 0.275"/><geometry><box size="0.53 0.020 0.080"/></geometry></collision>
      <collision name="rear_shell_lower_right_skirt_collision"><origin xyz="-0.285 -0.388 0.275"/><geometry><box size="0.53 0.020 0.080"/></geometry></collision>
      <collision name="rear_shell_lower_rear_rail_collision"><origin xyz="-0.540 0 0.275"/><geometry><box size="0.045 0.70 0.080"/></geometry></collision>
      <collision name="rear_shell_roof_left_collision"><origin xyz="-0.285 0.310 0.735"/><geometry><box size="0.53 0.080 0.055"/></geometry></collision>
      <collision name="rear_shell_roof_right_collision"><origin xyz="-0.285 -0.255 0.735"/><geometry><box size="0.53 0.180 0.055"/></geometry></collision>
      <collision name="rear_shell_roof_front_collision"><origin xyz="-0.065 0.135 0.735"/><geometry><box size="0.090 0.270 0.055"/></geometry></collision>
      <collision name="rear_shell_roof_rear_collision"><origin xyz="-0.500 0.135 0.735"/><geometry><box size="0.080 0.270 0.055"/></geometry></collision>
      <collision name="pylon_fairing_rear_collision"><origin xyz="0.355 0 0.775"/><geometry><box size="0.030 0.220 0.350"/></geometry></collision>
      <!-- The front shroud stops below the UTM shelf instead of occupying
           the bracket.  Rear/side panels retain the 1.1151 m fairing top, so
           the declared 47 mm scan-plane clearance remains conservative. -->
      <collision name="pylon_fairing_front_collision"><origin xyz="0.485 0 0.7475"/><geometry><box size="0.030 0.220 0.295"/></geometry></collision>
      <collision name="pylon_fairing_right_collision"><origin xyz="0.420 -0.0775 0.775"/><geometry><box size="0.100 0.015 0.350"/></geometry></collision>
      <collision name="pylon_fairing_left_collision"><origin xyz="0.420 0.0775 0.775"/><geometry><box size="0.100 0.015 0.350"/></geometry></collision>
      <xacro:hf_bodywork_box_inertial mass="3.10" sx="0.55" sy="0.76" sz="0.58" xyz="-0.28 0 0.49"/>
    </link>
    <joint name="bodywork_rear_shell_joint" type="fixed"><parent link="${parent}"/><child link="bodywork_rear_shell_link"/></joint>

    <!-- Four passive, manually latched service doors have explicit chassis
         hinge brackets, vertical hinge axes, hard angular limits and separate
         rotary latch joints.  Zero latch angle is the locked transport state;
         the latch must be released before a service operator moves the door. -->
    <xacro:hf_service_door name="bodywork_power_service_door" parent="${parent}"
      mesh="power_service_door.stl" material="service_door_white" rgba="0.77 0.81 0.80 1"
      door_mass="0.225" size="0.45 0.010 0.425" cog="0.225 0 0.2125" collision_xyz="0.225 0 0.2125"
      hinge_xyz="0.055 0.391 0.365" hinge_height="0.425" lower="0.0" upper="1.745329252"
      latch_xyz="0.390 0 0.200" latch_axis="0 1 0" visible="${visible}"/>
    <xacro:hf_service_door name="bodywork_compute_service_door" parent="${parent}"
      mesh="compute_service_door.stl" material="service_door_graphite" rgba="0.075 0.090 0.092 1"
      door_mass="0.105" size="0.27 0.010 0.12" cog="0.135 0 0.060" collision_xyz="0.135 0 0.060"
      hinge_xyz="0.235 -0.441 0.090" hinge_height="0.120" lower="-1.745329252" upper="0.0"
      latch_xyz="0.235 0 0.060" latch_axis="0 1 0" visible="${visible}"/>
    <xacro:hf_service_door name="bodywork_wet_service_door" parent="${parent}"
      mesh="wet_service_door.stl" material="service_door_white" rgba="0.77 0.81 0.80 1"
      door_mass="0.165" size="0.37 0.010 0.29" cog="0.185 0 0.145" collision_xyz="0.185 0 0.145"
      hinge_xyz="-0.430 -0.401 0.360" hinge_height="0.290" lower="-1.745329252" upper="0.0"
      latch_xyz="0.330 0 0.140" latch_axis="0 1 0" visible="${visible}"/>
    <xacro:hf_service_door name="bodywork_rear_dry_service_door" parent="${parent}"
      mesh="rear_dry_service_door.stl" material="service_door_white" rgba="0.77 0.81 0.80 1"
      door_mass="0.245" size="0.012 0.44 0.35" cog="0 -0.220 0.175" collision_xyz="0 -0.220 0.175"
      hinge_xyz="-0.562 0.220 0.325" hinge_height="0.350" lower="-1.745329252" upper="0.0"
      latch_xyz="0 -0.390 0.175" latch_axis="1 0 0" hinge_rpy="0 0 ${pi/2.0}" latch_rpy="0 0 ${pi/2.0}" visible="${visible}"/>

    <!-- Character line, sensor belt and graphics.  These parts are physical
         trim but use no separate collision because they are flush to the shell. -->
    <link name="bodywork_trim_link">
      <xacro:hf_body_visual mesh="front_sensor_band.stl" material="sensor_belt" rgba="0.020 0.030 0.032 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="rear_sensor_band.stl" material="sensor_belt" rgba="0.020 0.030 0.032 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="front_green_apron.stl" material="sanitation_green_apron" rgba="0.020 0.420 0.250 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="sanitation_green_accent.stl" material="sanitation_green" rgba="0.020 0.420 0.250 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="front_brand_badge.stl" material="badge_green" rgba="0.025 0.50 0.31 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="tow_eyes.stl" material="tow_metal" rgba="0.46 0.49 0.50 1" visible="${visible}"/>
      <!-- Charge and drain visuals/collisions moved to the articulated service
           hardware assembly; this trim link now carries only body graphics. -->
      <collision name="front_sensor_band_collision"><origin xyz="0.555 0 0.350"/><geometry><box size="0.018 0.500 0.055"/></geometry></collision>
      <xacro:hf_bodywork_box_inertial mass="0.32" sx="1.14" sy="0.82" sz="0.52" xyz="0 0 0.40"/>
    </link>
    <joint name="bodywork_trim_joint" type="fixed"><parent link="${parent}"/><child link="bodywork_trim_link"/></joint>

    <link name="bodywork_lighting_link">
      <xacro:hf_body_visual mesh="front_work_light_left.stl" material="front_lamp" rgba="0.90 0.96 1.0 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="front_work_light_right.stl" material="front_lamp" rgba="0.90 0.96 1.0 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="rear_tail_light_left.stl" material="rear_lamp" rgba="0.75 0.015 0.020 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="rear_tail_light_right.stl" material="rear_lamp" rgba="0.75 0.015 0.020 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="corner_beacons.stl" material="warning_amber" rgba="1.0 0.45 0.015 0.92" visible="${visible}"/>
      <!-- E-stop is an articulated latching plunger in power_service_hardware. -->
      <collision name="front_work_lights_collision"><origin xyz="0.566 0 0.348"/><geometry><box size="0.012 0.455 0.030"/></geometry></collision>
      <xacro:hf_bodywork_box_inertial mass="0.25" sx="1.14" sy="0.82" sz="0.32" xyz="0 0 0.55"/>
    </link>
    <joint name="bodywork_lighting_joint" type="fixed"><parent link="${parent}"/><child link="bodywork_lighting_link"/></joint>

    <xacro:hf_bodywork_datum name="charge_interface" parent="${parent}"
      xyz="0.250 0.402 0.330" rpy="${pi/2.0} 0 0"/>
    <xacro:hf_bodywork_datum name="wastewater_drain" parent="${parent}"
      xyz="-0.490 -0.305 0.315" rpy="0 ${pi/2.0} 0"/>
    <xacro:hf_bodywork_datum name="emergency_stop" parent="${parent}"
      xyz="-0.405 -0.405 0.680" rpy="${pi/2.0} 0 0"/>
    <xacro:hf_bodywork_datum name="warning_and_work_lighting" parent="${parent}"
      xyz="0 0 0.550"/>
    <xacro:hf_bodywork_datum name="front_contact_safety" parent="${parent}"
      xyz="0.555 0 0.105"/>
    <xacro:hf_bodywork_datum name="rear_contact_safety" parent="${parent}"
      xyz="-0.555 0 0.105"/>

    <!-- Guards cover motor/gear cases only; brush discs and bristles remain
         exposed and animated. -->
    <link name="bodywork_brush_guards_link">
      <xacro:hf_body_visual mesh="left_side_brush_motor_guard.stl" material="brush_guard" rgba="0.060 0.075 0.078 1" visible="${visible}"/>
      <xacro:hf_body_visual mesh="right_side_brush_motor_guard.stl" material="brush_guard" rgba="0.060 0.075 0.078 1" visible="${visible}"/>
      <collision name="left_brush_guard_collision"><origin xyz="0.38 0.50 0.065"/><geometry><box size="0.15 0.14 0.10"/></geometry></collision>
      <collision name="right_brush_guard_collision"><origin xyz="0.38 -0.50 0.065"/><geometry><box size="0.15 0.14 0.10"/></geometry></collision>
      <xacro:hf_bodywork_box_inertial mass="0.36" sx="0.16" sy="1.12" sz="0.11" xyz="0.38 0 0.065"/>
    </link>
    <joint name="bodywork_brush_guards_joint" type="fixed"><parent link="${parent}"/><child link="bodywork_brush_guards_link"/></joint>
  </xacro:macro>
</robot>
