<?xml version="1.0"?>
<!--
  Project-authored high-fidelity cleaning and wastewater-recovery mechanism.

  Project-owned visual meshes are regenerated from
  cad/formal_vehicle/generate_cleaning_storage_meshes.py. They reconstruct the
  observable envelopes, mounting hardware and service features from the frozen
  contract; they do not claim exact hidden motor gears, windings or pump
  diaphragms. Collision and inertia deliberately remain simple and stable.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="hf_clean_mesh_root"
                  value="package://sanitation_vehicle_description/meshes/project/cleaning"/>

  <xacro:macro name="hf_clean_visual"
               params="mesh material rgba origin_xyz:='0 0 0' origin_rpy:='0 0 0'">
    <visual>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <geometry><mesh filename="${hf_clean_mesh_root}/${mesh}"/></geometry>
      <material name="${material}"><color rgba="${rgba}"/></material>
    </visual>
  </xacro:macro>

  <xacro:macro name="hf_cleaning_box_inertial" params="mass sx sy sz xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (sy*sy + sz*sz) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (sx*sx + sz*sz) / 12.0}" iyz="0"
        izz="${mass * (sx*sx + sy*sy) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="hf_cleaning_cylinder_z_inertial" params="mass radius length xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + length*length) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (3.0*radius*radius + length*length) / 12.0}" iyz="0"
        izz="${0.5 * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="hf_cleaning_cylinder_y_inertial" params="mass radius length xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + length*length) / 12.0}" ixy="0" ixz="0"
        iyy="${0.5 * mass * radius*radius}" iyz="0"
        izz="${mass * (3.0*radius*radius + length*length) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="hf_side_brush_assembly" params="side lateral_sign">
    <!-- The 37D motor mass is partitioned across stator, gearbox and rotor/shaft;
         their sum is the vendor 0.205 kg per Pololu 4694 assembly. -->
    <link name="${side}_side_brush_motor_stator_link">
      <xacro:hf_clean_visual mesh="pololu_37d_motor_body.stl"
        material="hf_motor_dark" rgba="0.10 0.11 0.12 1"/>
      <collision><geometry><cylinder radius="0.0195" length="0.068"/></geometry></collision>
      <!-- The vendor 0.130 kg stator-side allocation is split so the magnetic
           64 CPR encoder cap is an explicit serviceable child rigid body. -->
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.115" radius="0.0185" length="0.057"/>
    </link>
    <joint name="${side}_side_brush_motor_mount_joint" type="fixed">
      <parent link="cleaning_lift_carriage_link"/>
      <child link="${side}_side_brush_motor_stator_link"/>
      <!-- At the 100 mm downstroke work pose, this installation height
           puts the conservative bristle-sweep collision tangent to z=0. -->
      <origin xyz="0.385 ${lateral_sign * 0.545} 0.0294" rpy="0 0 0"/>
    </joint>

    <link name="${side}_side_brush_encoder_link">
      <xacro:hf_clean_visual mesh="pololu_37d_encoder_cap.stl"
        material="hf_pololu_encoder_black" rgba="0.055 0.065 0.070 1"/>
      <collision><geometry><cylinder radius="0.0195" length="0.011"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.015" radius="0.0195" length="0.011"/>
    </link>
    <joint name="${side}_side_brush_encoder_mount_joint" type="fixed">
      <parent link="${side}_side_brush_motor_stator_link"/>
      <child link="${side}_side_brush_encoder_link"/>
      <origin xyz="0 0 0.034"/>
    </joint>

    <link name="${side}_side_brush_gearbox_link">
      <xacro:hf_clean_visual mesh="pololu_37d_gearbox.stl"
        material="hf_gearbox_silver" rgba="0.55 0.58 0.60 1"/>
      <collision><geometry><cylinder radius="0.0185" length="0.028"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.055" radius="0.0185" length="0.028"/>
    </link>
    <joint name="${side}_side_brush_gearbox_mount_joint" type="fixed">
      <parent link="${side}_side_brush_motor_stator_link"/>
      <child link="${side}_side_brush_gearbox_link"/>
      <origin xyz="0 0 -0.0425" rpy="0 0 0"/>
    </joint>

    <link name="${side}_side_brush_link">
      <xacro:hf_clean_visual mesh="side_brush_rotor_shaft.stl"
        material="hf_shaft_steel" rgba="0.62 0.65 0.68 1"/>
      <!-- Runtime brush/pavement contact belongs to this non-fixed rotating
           link so sdformat preserves the surface parameters.  The mesh and
           mass remain on their serviceable fixed children; this collision is
           expressed in the rotor frame (disk offset -52 mm plus compressed
           bristle-envelope offset -13 mm). -->
      <!-- Keep this direct collision unnamed.  sdformat 14.9 binds the URDF
           gazebo surface extension to the generated
           ${side}_side_brush_link_collision only in this form.  An explicit
           collision name is rewritten during fixed-joint lumping and drops
           the surface parameters from the expanded SDF. -->
      <collision>
        <origin xyz="0 0 -0.065"/>
        <geometry><cylinder radius="0.150" length="0.026"/></geometry>
      </collision>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.020" radius="0.006" length="0.052" xyz="0 0 -0.012"/>
    </link>
    <joint name="${side}_side_brush_joint" type="continuous">
      <parent link="${side}_side_brush_gearbox_link"/>
      <child link="${side}_side_brush_link"/>
      <origin xyz="0 0 -0.014" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <!-- Pololu 4694 public no-load speed is 140 rpm = 14.6608 rad/s;
           the 3.040 N.m value is its explicitly extrapolated stall torque. -->
      <limit effort="3.040473" velocity="14.660766"/>
      <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="${side}_side_brush_disk_link">
      <xacro:hf_clean_visual mesh="side_brush_disk.stl"
        material="hf_brush_disk" rgba="0.045 0.055 0.06 1"/>
      <collision><geometry><cylinder radius="0.072" length="0.012"/></geometry></collision>
      <!-- Shaft collision is expressed in the disk frame so the non-fixed
           rotor link has exactly one direct collision; its fixed descendants
           remain explicit service geometry after sdformat lumping. -->
      <collision name="rotor_shaft_collision">
        <origin xyz="0 0 0.040"/>
        <geometry><cylinder radius="0.006" length="0.052"/></geometry>
      </collision>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.230" radius="0.072" length="0.012"/>
    </link>
    <joint name="${side}_side_brush_disk_joint" type="fixed">
      <parent link="${side}_side_brush_link"/>
      <child link="${side}_side_brush_disk_link"/>
      <origin xyz="0 0 -0.052" rpy="0 0 0"/>
    </joint>

    <link name="${side}_side_brush_bristle_sectors_link">
      <xacro:hf_clean_visual mesh="side_brush_bristles.stl"
        material="hf_bristle_brown" rgba="0.30 0.19 0.065 1"/>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.290" radius="0.125" length="0.026" xyz="0 0 -0.018"/>
    </link>
    <joint name="${side}_side_brush_bristle_sectors_joint" type="fixed">
      <parent link="${side}_side_brush_disk_link"/>
      <child link="${side}_side_brush_bristle_sectors_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <!-- A rigid high-friction disk at the unloaded bristle tip numerically
         locks against pavement in DART, unlike discrete flexible PP bristles.
         Retain the full swept collision envelope and ground contact, but give
         the contact its measured-function proxy: low effective sliding
         friction plus compliant penetration.  The motor observer still trips
         a real stall if measured joint speed remains below threshold. -->
    <gazebo reference="${side}_side_brush_link">
      <mu1>0.08</mu1>
      <mu2>0.08</mu2>
      <kp>1500.0</kp>
      <kd>50.0</kd>
      <maxVel>0.20</maxVel>
      <minDepth>0.003</minDepth>
      <!-- Recovering liquid requires an observed pavement contact, not merely
           a brush-velocity command.  This sensor binds the direct rotor
           collision already checked in the expanded-SDF surface audit. -->
      <sensor name="${side}_side_brush_ground_contact" type="contact">
        <topic>/cleaning/${side}_side_brush/contact</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <contact><collision>${side}_side_brush_link_collision</collision></contact>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="high_fidelity_cleaning_mechanism"
               params="parent origin_xyz:='0 0 0' origin_rpy:='0 0 0'">
    <link name="cleaning_mechanism_mount_link">
      <xacro:hf_clean_visual mesh="cleaning_mount_frame.stl"
        material="hf_cleaning_frame" rgba="0.20 0.23 0.24 1"/>
      <collision><geometry><box size="0.34 0.58 0.045"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.650" sx="0.34" sy="0.58" sz="0.045"/>
    </link>
    <joint name="cleaning_mechanism_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="cleaning_mechanism_mount_link"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
    </joint>

    <!--
      Four chassis-fixed guide columns and two carriage-fixed bearing side
      plates form the physical 100 mm linear-guide load path.  The single
      cleaning_lift_joint below remains the idealized commanded translation;
      the bearing plates are rigid parts of its carriage, so they follow that
      motion without adding a second commanded DOF or an invalid URDF loop.

      The guide centres deliberately match the +/-180 mm x and +/-250 mm y
      bearing bosses authored into cleaning_lift_carriage.stl.  The previous
      +/-120 mm guide location did not pass through those bosses.
    -->
    <xacro:macro name="hf_lift_guide" params="name x y">
      <link name="${name}_link">
        <xacro:hf_clean_visual mesh="lift_guide_column.stl"
          material="hf_guide_chrome" rgba="0.66 0.69 0.71 1"/>
        <collision><geometry><cylinder radius="0.010" length="0.180"/></geometry></collision>
        <xacro:hf_cleaning_cylinder_z_inertial mass="0.110" radius="0.010" length="0.180"/>
      </link>
      <joint name="${name}_joint" type="fixed">
        <parent link="cleaning_mechanism_mount_link"/><child link="${name}_link"/>
        <!-- The 180 mm guide spans every 35 mm bearing boss position from
             q=0.000 m through q=0.100 m, including both end positions. -->
        <origin xyz="${x} ${y} -0.025" rpy="0 0 0"/>
      </joint>
    </xacro:macro>
    <xacro:hf_lift_guide name="cleaning_front_left_guide" x="0.18" y="0.25"/>
    <xacro:hf_lift_guide name="cleaning_front_right_guide" x="0.18" y="-0.25"/>
    <xacro:hf_lift_guide name="cleaning_rear_left_guide" x="-0.18" y="0.25"/>
    <xacro:hf_lift_guide name="cleaning_rear_right_guide" x="-0.18" y="-0.25"/>

    <link name="cleaning_lift_carriage_link">
      <xacro:hf_clean_visual mesh="cleaning_lift_carriage.stl"
        material="hf_lift_carriage" rgba="0.08 0.34 0.24 1"/>
      <collision><geometry><box size="0.46 0.62 0.035"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.750" sx="0.46" sy="0.62" sz="0.035"/>
    </link>
    <joint name="cleaning_lift_joint" type="prismatic">
      <parent link="cleaning_mechanism_mount_link"/>
      <child link="cleaning_lift_carriage_link"/>
      <!-- q=0 is the passive, controller-independent transport-safe pose.
           Positive position drives the carriage downward; q=0.100 m is the
           ground-tangent work pose.  Therefore an unclaimed controller at its
           physical zero cannot start with the brush/roller/squeegee in ground. -->
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <axis xyz="0 0 -1"/>
      <!-- Actuonix P16-100-256-12-P: 300 N maximum lifted load and
           4.8 mm/s no-load speed from the public manufacturer sheet. -->
      <limit lower="0.0" upper="0.100" effort="300.0" velocity="0.0048"/>
      <!-- The moving cleaning subtree is 5.95 kg (58.35 N under gravity).
           Model the P16 screw actuator's non-backdrivable hold with 80 N of
           static resistance: above the suspended load, but well below the
           actuator's 300 N commanded-force envelope. -->
      <dynamics damping="80.0" friction="80.0"/>
    </joint>

    <!-- Actuonix P16 body is chassis-fixed; its rod and clevis ride with the carriage. -->
    <link name="cleaning_lift_actuator_body_link">
      <xacro:hf_clean_visual mesh="actuonix_p16_body.stl"
        material="hf_p16_black" rgba="0.055 0.06 0.065 1"/>
      <collision><origin xyz="0 0 -0.005"/><geometry><cylinder radius="0.012" length="0.170"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.075" radius="0.012" length="0.170" xyz="0 0 -0.005"/>
    </link>
    <joint name="cleaning_lift_actuator_body_mount_joint" type="fixed">
      <parent link="cleaning_mechanism_mount_link"/><child link="cleaning_lift_actuator_body_link"/>
      <origin xyz="0 0.18 0.020" rpy="0 0 0"/>
    </joint>

    <link name="cleaning_lift_actuator_rod_link">
      <xacro:hf_clean_visual mesh="actuonix_p16_rod.stl"
        material="hf_p16_rod" rgba="0.72 0.74 0.75 1"/>
      <collision><origin xyz="0 0 0.050"/><geometry><cylinder radius="0.0045" length="0.100"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.025" radius="0.0045" length="0.100" xyz="0 0 0.050"/>
    </link>
    <joint name="cleaning_lift_actuator_rod_mount_joint" type="fixed">
      <parent link="cleaning_lift_carriage_link"/><child link="cleaning_lift_actuator_rod_link"/>
      <origin xyz="0 0.18 0.010" rpy="0 0 0"/>
    </joint>

    <link name="cleaning_lift_actuator_clevis_link">
      <xacro:hf_clean_visual mesh="actuonix_p16_clevis.stl"
        material="hf_p16_clevis" rgba="0.50 0.52 0.53 1"/>
      <collision><geometry><box size="0.024 0.012 0.020"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.010" sx="0.024" sy="0.012" sz="0.020"/>
    </link>
    <joint name="cleaning_lift_actuator_clevis_joint" type="fixed">
      <parent link="cleaning_lift_actuator_rod_link"/><child link="cleaning_lift_actuator_clevis_link"/>
      <origin xyz="0 0 0.105" rpy="0 0 0"/>
    </joint>

    <!--
      Each side plate is a real moving member of the linear guide and carries
      the front and rear bearing bosses already authored into the project mesh.
      The mesh's +/-110 mm boss pitch is scaled in x to the actual +/-180 mm
      guide centres.  Physical rail/bearing contact is omitted because the
      ideal prismatic joint already imposes the same constraint and duplicating
      it would over-constrain the Gazebo mechanism.  This is an engineering
      URDF model, not manufacturing CAD of the bearing races and seals.
    -->
    <xacro:macro name="hf_lift_slider_plate" params="name y">
      <link name="${name}_link">
        <visual name="bearing_side_plate_mesh">
          <geometry>
            <mesh filename="${hf_clean_mesh_root}/lift_linkage.stl"
                  scale="1.6363636363636365 1 1"/>
          </geometry>
          <material name="hf_lift_bearing"><color rgba="0.42 0.45 0.47 1"/></material>
        </visual>
        <!-- The collision keeps a central spine clear of the two guide axes;
             the prismatic constraint represents the bearing contacts. -->
        <collision name="bearing_side_plate_spine">
          <geometry><box size="0.320 0.018 0.030"/></geometry>
        </collision>
        <xacro:hf_cleaning_box_inertial mass="0.220" sx="0.409091" sy="0.023" sz="0.030"/>
      </link>
      <joint name="${name}_joint" type="fixed">
        <parent link="cleaning_lift_carriage_link"/><child link="${name}_link"/>
        <origin xyz="0 ${y} 0" rpy="0 0 0"/>
      </joint>
    </xacro:macro>
    <xacro:hf_lift_slider_plate name="cleaning_left_lift_slider_plate" y="0.25"/>
    <xacro:hf_lift_slider_plate name="cleaning_right_lift_slider_plate" y="-0.25"/>

    <xacro:hf_side_brush_assembly side="left" lateral_sign="1.0"/>
    <xacro:hf_side_brush_assembly side="right" lateral_sign="-1.0"/>

    <!-- Central brush: two bearings, one Pololu drive, shaft/core and six
         independent elastomer-bristle bars. The 0.62 m roller spans the intake. -->
    <link name="central_roller_left_bearing_link">
      <xacro:hf_clean_visual mesh="central_roller_bearing.stl"
        material="hf_bearing" rgba="0.45 0.47 0.48 1" origin_xyz="0 0.332 0"/>
      <collision><origin xyz="0 0.332 0" rpy="${pi/2.0} 0 0"/><geometry><cylinder radius="0.030" length="0.025"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_y_inertial mass="0.090" radius="0.030" length="0.025" xyz="0 0.332 0"/>
    </link>
    <joint name="central_roller_left_bearing_mount_joint" type="fixed">
      <parent link="cleaning_lift_carriage_link"/><child link="central_roller_left_bearing_link"/>
      <!-- The 100 mm bristle sweep is tangent to z=0 at q=0.100 m downstroke. -->
      <origin xyz="0.155 0 -0.0101" rpy="0 0 0"/>
    </joint>

    <link name="central_roller_motor_stator_link">
      <xacro:hf_clean_visual mesh="pololu_37d_motor_body.stl"
        material="hf_central_motor" rgba="0.10 0.11 0.12 1"
        origin_xyz="0 -0.367 0" origin_rpy="${pi/2.0} 0 0"/>
      <collision><origin xyz="0 -0.367 0" rpy="${pi/2.0} 0 0"/><geometry><cylinder radius="0.0195" length="0.068"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_y_inertial mass="0.115" radius="0.0185" length="0.057" xyz="0 -0.367 0"/>
    </link>
    <joint name="central_roller_motor_mount_joint" type="fixed">
      <parent link="cleaning_lift_carriage_link"/><child link="central_roller_motor_stator_link"/>
      <origin xyz="0.155 0 -0.0101" rpy="0 0 0"/>
    </joint>

    <link name="central_roller_encoder_link">
      <xacro:hf_clean_visual mesh="pololu_37d_encoder_cap.stl"
        material="hf_central_encoder_black" rgba="0.055 0.065 0.070 1"
        origin_rpy="${pi/2.0} 0 0"/>
      <collision><origin rpy="${pi/2.0} 0 0"/><geometry><cylinder radius="0.0195" length="0.011"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_y_inertial mass="0.015" radius="0.0195" length="0.011"/>
    </link>
    <joint name="central_roller_encoder_mount_joint" type="fixed">
      <parent link="central_roller_motor_stator_link"/>
      <child link="central_roller_encoder_link"/>
      <origin xyz="0 -0.401 0"/>
    </joint>

    <link name="central_roller_drive_gearbox_link">
      <xacro:hf_clean_visual mesh="pololu_37d_gearbox.stl"
        material="hf_central_gearbox" rgba="0.55 0.58 0.60 1"
        origin_xyz="0 -0.325 0" origin_rpy="${pi/2.0} 0 0"/>
      <collision><origin xyz="0 -0.325 0" rpy="${pi/2.0} 0 0"/><geometry><cylinder radius="0.0185" length="0.028"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_y_inertial mass="0.055" radius="0.0185" length="0.028" xyz="0 -0.325 0"/>
    </link>
    <joint name="central_roller_drive_gearbox_mount_joint" type="fixed">
      <parent link="central_roller_motor_stator_link"/><child link="central_roller_drive_gearbox_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="central_roller_link">
      <xacro:hf_clean_visual mesh="central_roller.stl"
        material="hf_roller_core" rgba="0.08 0.22 0.13 1"/>
      <!-- The visual contains a 60 mm rigid core plus six helical elastomer
           bars whose 100 mm outer sweep is represented here.  DART cannot
           consume URDF contact stiffness for flexible bristles, so this
           rotating collision is an explicitly bounded, low-effective-
           friction contact proxy rather than a rigid high-friction wheel. -->
      <!-- Keep the direct collision unnamed so sdformat binds the Gazebo
           surface extension to central_roller_link_collision. -->
      <collision><origin rpy="${pi/2.0} 0 0"/><geometry><cylinder radius="0.100" length="0.620"/></geometry></collision>
      <!-- Includes the 0.020 kg rotor/shaft share of the third Pololu motor. -->
      <xacro:hf_cleaning_cylinder_y_inertial mass="1.220" radius="0.085" length="0.620"/>
    </link>
    <joint name="central_roller_joint" type="continuous">
      <parent link="central_roller_drive_gearbox_link"/><child link="central_roller_link"/>
      <origin xyz="0 0 0" rpy="0 ${pi/2.0} 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="3.040473" velocity="14.660766"/>
      <dynamics damping="0.015" friction="0.012"/>
    </joint>
    <gazebo reference="central_roller_link">
      <mu1>0.08</mu1>
      <mu2>0.08</mu2>
      <kp>1500.0</kp>
      <kd>50.0</kd>
      <maxVel>0.20</maxVel>
      <minDepth>0.003</minDepth>
      <sensor name="central_roller_ground_contact" type="contact">
        <topic>/cleaning/central_roller/contact</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <contact><collision>central_roller_link_collision</collision></contact>
      </sensor>
    </gazebo>

    <link name="central_roller_guard_link">
      <xacro:hf_clean_visual mesh="central_roller_guard.stl"
        material="hf_roller_guard" rgba="0.08 0.31 0.22 1"/>
      <collision><origin xyz="-0.04 0 0.020"/><geometry><box size="0.250 0.680 0.025"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.400" sx="0.250" sy="0.680" sz="0.025" xyz="-0.04 0 0.020"/>
    </link>
    <joint name="central_roller_guard_mount_joint" type="fixed">
      <parent link="cleaning_lift_carriage_link"/><child link="central_roller_guard_link"/>
      <origin xyz="0 0 -0.080" rpy="0 0 0"/>
    </joint>

    <!-- Two-axis passive squeegee suspension. URDF dynamics retain fail-safe
         damping; the model-level Gazebo plugin below applies the physical
         preload and bounded spring laws to these real joints. -->
    <link name="squeegee_float_carrier_link">
      <xacro:hf_clean_visual mesh="squeegee_float_carrier.stl"
        material="hf_squeegee_carrier" rgba="0.23 0.25 0.26 1"/>
      <collision><geometry><box size="0.075 0.84 0.045"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.250" sx="0.075" sy="0.84" sz="0.045"/>
    </link>
    <joint name="squeegee_float_joint" type="prismatic">
      <parent link="cleaning_lift_carriage_link"/><child link="squeegee_float_carrier_link"/>
      <!-- At q=0.100 m downstroke and zero float/pitch displacement,
           the rubber blade collision is tangent to z=0 and the intake retains
           a 5 mm geometric gap.  The +/-15 mm joint remains compliance travel;
           this datum is not physical contact-force evidence. -->
      <origin xyz="-0.445 0 -0.0376" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.015" upper="0.015" effort="250.0" velocity="0.10"/>
      <dynamics damping="45.0" friction="4.0"/>
    </joint>

    <link name="squeegee_spring_pack_link">
      <xacro:hf_clean_visual mesh="squeegee_springs.stl"
        material="hf_spring" rgba="0.70 0.72 0.73 1"/>
      <collision name="left_spring_collision"><origin xyz="0 0.30 0.050"/><geometry><cylinder radius="0.016" length="0.085"/></geometry></collision>
      <collision name="right_spring_collision"><origin xyz="0 -0.30 0.050"/><geometry><cylinder radius="0.016" length="0.085"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.080" sx="0.032" sy="0.632" sz="0.085" xyz="0 0 0.050"/>
    </link>
    <joint name="squeegee_spring_pack_joint" type="fixed">
      <parent link="squeegee_float_carrier_link"/><child link="squeegee_spring_pack_link"/><origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="squeegee_link">
      <xacro:hf_clean_visual mesh="squeegee_backing.stl"
        material="hf_squeegee_rail" rgba="0.58 0.60 0.61 1"/>
      <xacro:hf_clean_visual mesh="squeegee_blades.stl"
        material="hf_squeegee_rubber" rgba="0.035 0.04 0.045 1"/>
      <collision name="squeegee_blade_collision"><origin xyz="0 0 -0.005"/><geometry><box size="0.065 0.800 0.095"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.650" sx="0.065" sy="0.800" sz="0.095" xyz="0 0 -0.005"/>
    </link>
    <joint name="squeegee_pitch_joint" type="revolute">
      <parent link="squeegee_float_carrier_link"/><child link="squeegee_link"/>
      <origin xyz="0 0 -0.020" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.174533" upper="0.174533" effort="80.0" velocity="0.50"/>
      <dynamics damping="18.0" friction="1.2"/>
    </joint>
    <!-- Damping/friction are represented in URDF joint dynamics above. -->

    <gazebo>
      <plugin filename="libSqueegeeComplianceSystem.so"
              name="sanitation_gazebo_auxiliary::SqueegeeComplianceSystem">
        <!-- -6 mm reference gives 10.8 N nominal preload at the ground-tangent
             zero pose.  The contact solver supplies the opposing ground load. -->
        <float_stiffness_n_per_m>1800.0</float_stiffness_n_per_m>
        <float_damping_ns_per_m>45.0</float_damping_ns_per_m>
        <float_preload_reference_m>-0.006</float_preload_reference_m>
        <float_max_force_n>120.0</float_max_force_n>
        <pitch_stiffness_nm_per_rad>32.0</pitch_stiffness_nm_per_rad>
        <pitch_damping_nms_per_rad>6.0</pitch_damping_nms_per_rad>
        <pitch_reference_rad>0.0</pitch_reference_rad>
        <pitch_max_torque_nm>24.0</pitch_max_torque_nm>
        <telemetry_topic_prefix>/model/tzcup_formal_sanitation_vehicle/squeegee_compliance</telemetry_topic_prefix>
      </plugin>
    </gazebo>
    <gazebo reference="squeegee_link">
      <sensor name="squeegee_blade_ground_contact" type="contact">
        <topic>/cleaning/squeegee/contact</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <!-- sdformat folds the fixed suction-nozzle child into squeegee_link and
             consequently renames this URDF collision in the generated SDF.
             Contact sensors bind against that post-conversion SDF name. -->
        <contact><collision>squeegee_link_fixed_joint_lump__squeegee_blade_collision_collision</collision></contact>
      </sensor>
    </gazebo>

    <link name="suction_nozzle_link">
      <xacro:hf_clean_visual mesh="suction_nozzle.stl"
        material="hf_nozzle" rgba="0.075 0.09 0.10 1"/>
      <collision name="suction_nozzle_link_collision"><geometry><box size="0.100 0.650 0.085"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.400" sx="0.100" sy="0.650" sz="0.085"/>
    </link>
    <joint name="suction_nozzle_mount_joint" type="fixed">
      <parent link="squeegee_link"/><child link="suction_nozzle_link"/>
      <!-- The intake box bottom retains a nominal 4-6 mm gap while the rubber
           squeegee blade is grounded; the intake itself must not scrape. -->
      <origin xyz="0.040 0 -0.005" rpy="0 0 0"/>
    </joint>
    <gazebo reference="suction_nozzle_link">
      <sensor name="suction_nozzle_ground_contact" type="contact">
        <topic>/cleaning/suction_nozzle/contact</topic><update_rate>100</update_rate><always_on>true</always_on>
        <contact><collision>suction_nozzle_link_collision</collision></contact>
      </sensor>
    </gazebo>

    <!-- Segmented hose geometry reserves a 50 mm ID flow path.  The three
         centres follow one continuous rising route from the rear nozzle into
         the enclosed pump bay; explicit chassis-relative mounts avoid the
         cumulative transform gap that made the upper segment appear detached. -->
    <xacro:macro name="hf_hose_segment" params="name parent xyz rpy length mass mesh">
      <link name="${name}_link">
        <xacro:hf_clean_visual mesh="${mesh}" material="hf_hose" rgba="0.035 0.04 0.045 1"/>
        <collision><origin rpy="0 ${pi/2.0} 0"/><geometry><cylinder radius="0.031" length="${length}"/></geometry></collision>
        <xacro:hf_cleaning_box_inertial mass="${mass}" sx="${length}" sy="0.062" sz="0.062"/>
      </link>
      <joint name="${name}_joint" type="fixed"><parent link="${parent}"/><child link="${name}_link"/><origin xyz="${xyz}" rpy="${rpy}"/></joint>
    </xacro:macro>
    <xacro:hf_hose_segment name="recovery_hose_lower" parent="cleaning_mechanism_mount_link" xyz="-0.470 0 0.100" rpy="0 -0.750 0" length="0.22" mass="0.140" mesh="recovery_hose_220.stl"/>
    <xacro:hf_hose_segment name="recovery_hose_middle" parent="cleaning_mechanism_mount_link" xyz="-0.320 0 0.280" rpy="0 -0.950 0" length="0.25" mass="0.160" mesh="recovery_hose_250.stl"/>
    <xacro:hf_hose_segment name="recovery_hose_upper" parent="cleaning_mechanism_mount_link" xyz="-0.202 0 0.471" rpy="0 -1.100 0" length="0.20" mass="0.120" mesh="recovery_hose_200.stl"/>

    <link name="recovery_strainer_filter_link">
      <xacro:hf_clean_visual mesh="strainer_filter_bowl.stl"
        material="hf_filter_bowl" rgba="0.62 0.76 0.80 0.55"/>
      <xacro:hf_clean_visual mesh="strainer_filter_head.stl"
        material="hf_filter_head" rgba="0.08 0.10 0.11 1"/>
      <collision><origin xyz="0 0 -0.025"/><geometry><cylinder radius="0.065" length="0.130"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.750" radius="0.065" length="0.130" xyz="0 0 -0.025"/>
    </link>
    <joint name="recovery_strainer_filter_mount_joint" type="fixed">
      <parent link="cleaning_mechanism_mount_link"/><child link="recovery_strainer_filter_link"/>
      <origin xyz="-0.25 0.20 0.17" rpy="0 0 0"/>
    </joint>

    <!-- Jabsco PAR-MAX HD4 Q402J-118S-3A: motor, diaphragm head and isolator
         plate are explicit rigid bodies; aggregate dry mass is 2.500 kg. -->
    <link name="recovery_pump_motor_link">
      <xacro:hf_clean_visual mesh="jabsco_pump_motor.stl"
        material="hf_pump_motor" rgba="0.10 0.12 0.13 1"/>
      <collision><origin rpy="0 ${pi/2.0} 0"/><geometry><cylinder radius="0.055" length="0.150"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="1.350" sx="0.150" sy="0.110" sz="0.110"/>
    </link>
    <joint name="recovery_pump_motor_mount_joint" type="fixed">
      <parent link="cleaning_mechanism_mount_link"/><child link="recovery_pump_motor_link"/>
      <origin xyz="-0.25 -0.16 0.18" rpy="0 0 0"/>
    </joint>

    <link name="recovery_pump_head_link">
      <xacro:hf_clean_visual mesh="jabsco_pump_head.stl"
        material="hf_pump_head" rgba="0.035 0.05 0.055 1"/>
      <collision><geometry><cylinder radius="0.072" length="0.065"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.950" radius="0.072" length="0.065"/>
    </link>
    <joint name="recovery_pump_head_joint" type="fixed">
      <parent link="recovery_pump_motor_link"/><child link="recovery_pump_head_link"/>
      <origin xyz="-0.1075 0 0" rpy="0 ${pi/2.0} 0"/>
    </joint>

    <!-- The externally observable motor/diaphragm drive is no longer a fixed
         decorative pump.  This rotor joint is the controlled shaft datum used
         by the recovery controller and hydraulic accounting layer. -->
    <link name="recovery_pump_rotor_link">
      <xacro:hf_clean_visual mesh="jabsco_pump_rotor.stl"
        material="hf_pump_rotor" rgba="0.58 0.61 0.62 1"/>
      <collision><geometry><cylinder radius="0.035" length="0.018"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_z_inertial mass="0.120" radius="0.035" length="0.018"/>
    </link>
    <joint name="recovery_pump_joint" type="continuous">
      <parent link="recovery_pump_head_link"/><child link="recovery_pump_rotor_link"/>
      <origin xyz="0 0 0.043" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <!-- Jabsco does not publish the diaphragm cam torque/speed. The 600 rpm
           and 2 N.m limits are explicit engineering calibration values; the
           published 6 A operating and 10 A fuse limits live in the motor core. -->
      <limit effort="2.0" velocity="62.832"/>
      <dynamics damping="0.025" friction="0.015"/>
    </joint>

    <link name="recovery_pump_isolator_mount_link">
      <xacro:hf_clean_visual mesh="pump_isolator_mount.stl"
        material="hf_pump_mount" rgba="0.36 0.39 0.40 1"/>
      <collision><geometry><box size="0.225 0.165 0.008"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.200" sx="0.225" sy="0.165" sz="0.008"/>
    </link>
    <joint name="recovery_pump_isolator_mount_joint" type="fixed">
      <parent link="recovery_pump_motor_link"/><child link="recovery_pump_isolator_mount_link"/>
      <origin xyz="0 0 -0.070" rpy="0 0 0"/>
    </joint>

    <link name="wastewater_delivery_coupling_link">
      <xacro:hf_clean_visual mesh="quick_coupling.stl"
        material="hf_quick_coupling" rgba="0.38 0.41 0.42 1"/>
      <collision><origin rpy="${pi/2.0} 0 0"/><geometry><cylinder radius="0.018" length="0.060"/></geometry></collision>
      <xacro:hf_cleaning_cylinder_y_inertial mass="0.080" radius="0.018" length="0.060"/>
    </link>
    <joint name="wastewater_delivery_coupling_joint" type="fixed">
      <parent link="recovery_pump_head_link"/><child link="wastewater_delivery_coupling_link"/>
      <origin xyz="0 -0.095 0" rpy="0 0 0"/>
    </joint>

    <link name="recovery_flow_sensor_link">
      <xacro:hf_clean_visual mesh="inline_flow_sensor.stl"
        material="hf_flow_sensor" rgba="0.08 0.28 0.38 1"/>
      <collision><geometry><box size="0.070 0.105 0.075"/></geometry></collision>
      <xacro:hf_cleaning_box_inertial mass="0.220" sx="0.070" sy="0.105" sz="0.075"/>
    </link>
    <joint name="recovery_flow_sensor_mount_joint" type="fixed">
      <parent link="wastewater_delivery_coupling_link"/><child link="recovery_flow_sensor_link"/>
      <origin xyz="0 -0.095 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
