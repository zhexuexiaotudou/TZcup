<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Project-authored sensor envelopes based on the frozen public dimensions.
       Gazebo Harmonic sensor topics deliberately match pre_urdf_contract.yaml. -->

  <xacro:macro name="hf_sensor_box_inertia" params="mass x y z">
    <inertia ixx="${mass*(y*y+z*z)/12.0}" ixy="0" ixz="0"
             iyy="${mass*(x*x+z*z)/12.0}" iyz="0"
             izz="${mass*(x*x+y*y)/12.0}"/>
  </xacro:macro>

  <xacro:macro name="hf_virtual_optical_link" params="name parent xyz rpy">
    <link name="${name}">
      <!-- Optical frames are mathematical datums.  Epsilon inertia avoids a
           zero-inertia link in strict offline validation. -->
      <inertial><mass value="0.000001"/><inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/></inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}"/>
      <!-- body: +X forward,+Y left,+Z up; optical: +Z forward,+X right,+Y down -->
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="hf_d435" params="name parent xyz rpy topic ir_left_topic ir_right_topic max_range mount_bracket:=false runtime_enabled:=true">
    <xacro:if value="${mount_bracket}">
      <link name="${name}_mount_link">
        <visual name="${name}_machined_side_bracket_visual">
          <geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/sensors/wrist_rgbd_side_bracket.stl"/></geometry>
          <material name="${name}_bracket"><color rgba="0.25 0.27 0.28 1"/></material>
        </visual>
        <!-- The optical axis is local +X.  Every load-carrying bracket member
             therefore stays behind the D435 rear plane (x <= -12.5 mm),
             rather than crossing the emitted depth frustum. -->
        <collision name="${name}_bracket_camera_plate_collision"><origin xyz="-0.016 0.010 0.027"/><geometry><box size="0.006 0.055 0.055"/></geometry></collision>
        <collision name="${name}_bracket_camera_standoff_collision"><origin xyz="-0.020 0.004 0.029"/><geometry><box size="0.008 0.030 0.064"/></geometry></collision>
        <collision name="${name}_bracket_outboard_rail_collision"><origin xyz="-0.024 0.070 0.060"/><geometry><box size="0.008 0.145 0.030"/></geometry></collision>
        <collision name="${name}_bracket_adapter_flange_collision"><origin xyz="-0.024 0.140 0.049"/><geometry><box size="0.008 0.070 0.022"/></geometry></collision>
        <collision name="${name}_bracket_flange_bridge_collision"><origin xyz="-0.044 0.124 0.049"/><geometry><box size="0.040 0.008 0.022"/></geometry></collision>
        <!-- 236.709 g project-machined aluminium bracket, separated from the
             public 75 g D435 housing so their load path and replacement datum
             are independently inspectable. -->
        <inertial>
          <origin xyz="-0.024 0.06018820 0.04530774"/>
          <mass value="0.236709"/>
          <xacro:hf_sensor_box_inertia mass="0.236709" x="0.070" y="0.145" z="0.064"/>
        </inertial>
      </link>
      <joint name="${name}_bracket_joint" type="fixed">
        <parent link="${parent}"/><child link="${name}_mount_link"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
      </joint>
    </xacro:if>
    <link name="${name}_link">
      <visual name="${name}_housing_visual">
        <!-- Robotnik's D435 datum is the left IR/depth imager.  Preserve its
             published mesh transform instead of centering a generic box. -->
        <origin xyz="0.0149 -0.0175 0" rpy="${pi/2.0} 0 ${pi/2.0}"/>
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/intel_d435_color.dae"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 -0.0175 0"/>
        <geometry><box size="0.02505 0.090 0.025"/></geometry>
      </collision>
      <!-- Two additional optical datums below carry 1 microgram each so the
           strict URDF checker can retain them as links.  Remove the same two
           micrograms from the public 75 g housing allocation: adding the
           complete stereo frame tree therefore changes neither D435 nor
           whole-vehicle mass. -->
      <inertial><origin xyz="0 -0.0175 0"/><mass value="0.074998"/><xacro:hf_sensor_box_inertia mass="0.074998" x="0.02505" y="0.090" z="0.025"/></inertial>
    </link>
    <xacro:if value="${mount_bracket}">
      <joint name="${name}_mount_joint" type="fixed">
        <parent link="${name}_mount_link"/><child link="${name}_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${mount_bracket}">
      <joint name="${name}_mount_joint" type="fixed">
        <parent link="${parent}"/><child link="${name}_link"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
      </joint>
    </xacro:unless>
    <xacro:hf_virtual_optical_link name="${name}_depth_optical_frame" parent="${name}_link"
                                   xyz="0 0 0" rpy="-${pi/2.0} 0 -${pi/2.0}"/>
    <!-- D435 depth is derived from its real stereo pair.  The housing datum is
         the left IR imager and the right imager is 50 mm to camera-right
         (body-frame -Y).  Keep both optical datums explicit even though the
         existing RGBD sensor continues to publish registered color/depth. -->
    <xacro:hf_virtual_optical_link name="${name}_infra1_optical_frame" parent="${name}_link"
                                   xyz="0 0 0" rpy="-${pi/2.0} 0 -${pi/2.0}"/>
    <xacro:hf_virtual_optical_link name="${name}_infra2_optical_frame" parent="${name}_link"
                                   xyz="0 -0.050 0" rpy="-${pi/2.0} 0 -${pi/2.0}"/>
    <xacro:if value="${runtime_enabled}">
      <gazebo reference="${name}_link">
      <sensor name="${name}_d435_rgbd" type="rgbd_camera">
        <topic>${topic}</topic><update_rate>30</update_rate>
        <always_on>true</always_on><visualize>false</visualize>
        <gz_frame_id>${name}_depth_optical_frame</gz_frame_id>
        <camera>
          <optical_frame_id>${name}_depth_optical_frame</optical_frame_id>
          <horizontal_fov>1.518436</horizontal_fov>
          <image><width>848</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.2</near><far>${max_range}</far></clip>
          <!-- Intrinsics are internally consistent with the 87 x 58 degree
               D435 envelope at 848 x 480; deployment replaces these with the
               serial-number-specific calibration. -->
          <lens><intrinsics><fx>447.2</fx><fy>433.0</fy><cx>424.0</cx><cy>240.0</cy><s>0</s></intrinsics></lens>
          <depth_camera><output>depths</output></depth_camera>
        </camera>
      </sensor>
      <sensor name="${name}_d435_infra1" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <topic>${ir_left_topic}</topic><update_rate>30</update_rate>
        <always_on>true</always_on><visualize>false</visualize>
        <gz_frame_id>${name}_infra1_optical_frame</gz_frame_id>
        <camera>
          <optical_frame_id>${name}_infra1_optical_frame</optical_frame_id>
          <camera_info_topic>${ir_left_topic}/camera_info</camera_info_topic>
          <horizontal_fov>1.518436</horizontal_fov>
          <image><width>848</width><height>480</height><format>L_INT8</format></image>
          <clip><near>0.2</near><far>${max_range}</far></clip>
          <lens><intrinsics><fx>447.2</fx><fy>433.0</fy><cx>424.0</cx><cy>240.0</cy><s>0</s></intrinsics></lens>
        </camera>
      </sensor>
      <sensor name="${name}_d435_infra2" type="camera">
        <pose>0 -0.050 0 0 0 0</pose>
        <topic>${ir_right_topic}</topic><update_rate>30</update_rate>
        <always_on>true</always_on><visualize>false</visualize>
        <gz_frame_id>${name}_infra2_optical_frame</gz_frame_id>
        <camera>
          <optical_frame_id>${name}_infra2_optical_frame</optical_frame_id>
          <camera_info_topic>${ir_right_topic}/camera_info</camera_info_topic>
          <horizontal_fov>1.518436</horizontal_fov>
          <image><width>848</width><height>480</height><format>L_INT8</format></image>
          <clip><near>0.2</near><far>${max_range}</far></clip>
          <lens><intrinsics><fx>447.2</fx><fy>433.0</fy><cx>424.0</cx><cy>240.0</cy><s>0</s></intrinsics></lens>
        </camera>
      </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="hf_fisheye" params="name parent xyz rpy optical_xyz optical_rpy topic runtime_enabled:=true">
    <link name="${name}_link">
      <visual name="${name}_rugged_housing_visual">
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/sensors/rugged_fisheye_module.stl"/></geometry>
        <material name="${name}_housing"><color rgba="0.06 0.08 0.09 1"/></material>
      </visual>
      <collision><geometry><box size="0.020 0.038 0.038"/></geometry></collision>
      <inertial><mass value="0.039999"/><xacro:hf_sensor_box_inertia mass="0.039999" x="0.020" y="0.038" z="0.038"/></inertial>
    </link>
    <joint name="${name}_mount_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <xacro:hf_virtual_optical_link name="${name}_optical_frame" parent="${name}_link"
                                   xyz="${optical_xyz}" rpy="${optical_rpy}"/>
    <xacro:if value="${runtime_enabled}">
      <gazebo reference="${name}_link">
      <!-- Nominal simulation lens, not a serial-number camera calibration.
           SDFormat renders an equisolid-angle projection
             r = 2 f sin(theta / 2)
           while formal_fisheye_camera_info_publisher.py publishes the same
           mapping through ROS's equidistant (Kannala-Brandt) polynomial.  Its
           non-zero coefficients are the theta^9 Taylor representation
           of this exact SDF mapping.  The public M27195H15 source freezes only
           the 150 x 129 degree lens envelope; an as-built calibration remains
           mandatory before real-camera deployment. -->
      <sensor name="${name}_imx291" type="wideanglecamera">
        <topic>${topic}</topic><update_rate>30</update_rate>
        <always_on>true</always_on><visualize>false</visualize>
        <gz_frame_id>${name}_optical_frame</gz_frame_id>
        <camera>
          <optical_frame_id>${name}_optical_frame</optical_frame_id>
          <horizontal_fov>2.617994</horizontal_fov>
          <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
          <clip><near>0.2</near><far>20.0</far></clip>
          <lens>
            <type>equisolid_angle</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.570796327</cutoff_angle>
            <env_texture_size>1024</env_texture_size>
          </lens>
        </camera>
      </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="hf_sensor_suite" params="mast_parent base_parent wrist_parent high_bandwidth_runtime:=true">
    <!-- Every fixed sensor is connected through a named, physical mounting
         link.  This makes the installation hierarchy inspectable in TF/URDF
         and keeps the visible vendor housing separate from project-owned CAD. -->

    <!-- Hokuyo UTM-30LX: 60 x 60 x 87 mm, 0.37 kg, 270 deg at 40 Hz. -->
    <link name="lidar_2d_mount_link">
      <visual name="utm30lx_bracket_visual"><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/utm30lx_mount.stl"/></geometry>
        <material name="sensor_mount_silver"><color rgba="0.42 0.46 0.47 1"/></material></visual>
      <collision name="utm_shelf_collision"><origin xyz="0.020 0 0.006"/><geometry><box size="0.150 0.120 0.014"/></geometry></collision>
      <collision name="utm_backplate_collision"><origin xyz="-0.048 0 -0.030"/><geometry><box size="0.014 0.105 0.090"/></geometry></collision>
      <collision name="utm_pad_collision"><origin xyz="0.055 0 0.019"/><geometry><box size="0.100 0.090 0.008"/></geometry></collision>
      <inertial><mass value="0.42"/><xacro:hf_sensor_box_inertia mass="0.42" x="0.150" y="0.120" z="0.110"/></inertial>
    </link>
    <joint name="lidar_2d_bracket_joint" type="fixed"><parent link="${mast_parent}"/><child link="lidar_2d_mount_link"/>
      <!-- Keep the 270 degree measurement plane above the moulded mast
           fairing.  The 47 mm vertical clearance prevents the rear edge of
           the physical fairing from masking both side sectors. -->
      <origin xyz="0.060 0 0.695"/></joint>
    <link name="lidar_2d_link">
      <visual name="utm30lx_mesh"><geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/hokuyo_utm_30lx.dae"/></geometry>
        <material name="utm30lx_blue"><color rgba="0.08 0.29 0.44 1"/></material></visual>
      <collision><origin xyz="0 0 -0.0115"/><geometry><box size="0.060 0.060 0.087"/></geometry></collision>
      <inertial><origin xyz="0 0 -0.0115"/><mass value="0.37"/><xacro:hf_sensor_box_inertia mass="0.37" x="0.060" y="0.060" z="0.087"/></inertial>
    </link>
    <joint name="lidar_2d_mount_joint" type="fixed"><parent link="lidar_2d_mount_link"/><child link="lidar_2d_link"/>
      <origin xyz="0.055 0 0.078"/></joint>
    <gazebo reference="lidar_2d_link">
      <sensor name="utm30lx" type="gpu_lidar">
        <topic>/sensors/lidar_2d/scan</topic><update_rate>40</update_rate><always_on>true</always_on><visualize>false</visualize>
        <gz_frame_id>lidar_2d_link</gz_frame_id>
        <lidar><scan><horizontal><samples>1080</samples><resolution>1</resolution><min_angle>-2.356194</min_angle><max_angle>2.356194</max_angle></horizontal>
          <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan>
          <range><min>0.1</min><max>30.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.030</stddev></noise></lidar>
      </sensor>
    </gazebo>

    <!-- Livox MID-360 physical envelope and non-repeating scan approximation. -->
    <link name="lidar_3d_mount_link">
      <visual name="mid360_isolator_plate_visual"><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/mid360_mount.stl"/></geometry>
        <material name="mid360_mount_silver"><color rgba="0.48 0.52 0.53 1"/></material></visual>
      <collision><origin xyz="0 0 0.017"/><geometry><cylinder radius="0.070" length="0.034"/></geometry></collision>
      <inertial><origin xyz="0 0 0.017"/><mass value="0.28"/><inertia ixx="0.000360" ixy="0" ixz="0" iyy="0.000360" iyz="0" izz="0.000686"/></inertial>
    </link>
    <joint name="lidar_3d_bracket_joint" type="fixed"><parent link="${mast_parent}"/><child link="lidar_3d_mount_link"/>
      <origin xyz="0 0 0.790"/></joint>
    <link name="lidar_3d_link">
      <visual name="mid360_mesh">
        <!-- The vendor STL is millimetres; the sensor datum sits 36.5 mm
             above the base used by the Robotnik visual. -->
        <origin xyz="0 0 -0.0365" rpy="${pi/2.0} 0 0"/>
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/livox_mid_360.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="mid360_dark_gray"><color rgba="0.11 0.13 0.14 1"/></material>
      </visual>
      <collision><origin xyz="0 0 -0.0325"/><geometry><cylinder radius="0.041" length="0.060"/></geometry></collision>
      <inertial><origin xyz="0 0 -0.0325"/><mass value="0.265"/><inertia ixx="0.000103" ixy="0" ixz="0" iyy="0.000103" iyz="0" izz="0.000140"/></inertial>
    </link>
    <joint name="lidar_3d_mount_joint" type="fixed"><parent link="lidar_3d_mount_link"/><child link="lidar_3d_link"/>
      <origin xyz="0 0 0.094"/></joint>
    <xacro:if value="${high_bandwidth_runtime}">
      <gazebo reference="lidar_3d_link">
      <sensor name="mid360" type="gpu_lidar">
        <!-- Gazebo publishes LaserScan on this base topic and PointCloudPacked
             on its /points child.  Keep the base free of the /points suffix so
             the ROS PointCloud2 contract is exactly /sensors/lidar_3d/points. -->
        <topic>/sensors/lidar_3d</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
        <gz_frame_id>lidar_3d_link</gz_frame_id>
        <lidar><scan><horizontal><samples>1800</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal>
          <!-- MID-360 published vertical field of view: -7 to +52 degrees. -->
          <vertical><samples>64</samples><resolution>1</resolution><min_angle>-0.122173</min_angle><max_angle>0.907571</max_angle></vertical></scan>
          <range><min>0.1</min><max>40.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.020</stddev></noise></lidar>
      </sensor>
      </gazebo>
    </xacro:if>

    <link name="front_rgbd_mount_link">
      <visual name="front_rgbd_bezel_visual"><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/front_rgbd_mount.stl"/></geometry>
        <material name="front_rgbd_bezel"><color rgba="0.055 0.070 0.073 1"/></material></visual>
      <collision name="front_rgbd_upper_bezel"><origin xyz="0 0 0.030"/><geometry><box size="0.045 0.132 0.008"/></geometry></collision>
      <collision name="front_rgbd_lower_bezel"><origin xyz="0 0 -0.030"/><geometry><box size="0.045 0.132 0.008"/></geometry></collision>
      <collision name="front_rgbd_left_bezel"><origin xyz="0 0.062 0"/><geometry><box size="0.045 0.008 0.052"/></geometry></collision>
      <collision name="front_rgbd_right_bezel"><origin xyz="0 -0.062 0"/><geometry><box size="0.045 0.008 0.052"/></geometry></collision>
      <inertial><mass value="0.18"/><xacro:hf_sensor_box_inertia mass="0.18" x="0.045" y="0.132" z="0.067"/></inertial>
    </link>
    <joint name="front_rgbd_bracket_joint" type="fixed"><parent link="${base_parent}"/><child link="front_rgbd_mount_link"/>
      <!-- A 25 degree depression covers the ground from just ahead of the
           front bumper through the long-range litter perception corridor. -->
      <origin xyz="0.565 0 0.449" rpy="0 0.436332313 0"/></joint>
    <xacro:hf_d435 name="front_rgbd" parent="front_rgbd_mount_link" xyz="0.005 0 0" rpy="0 0 0"
                    topic="/sensors/front_rgbd/depth/image_rect_raw"
                    ir_left_topic="/sensors/front_rgbd/infra1/image_rect_raw"
                    ir_right_topic="/sensors/front_rgbd/infra2/image_rect_raw" max_range="10.0"
                    runtime_enabled="${high_bandwidth_runtime}"/>
    <!-- Side bracket position keeps the camera outside the Robotiq base and
         turns its optical +X onto the gripper's +Z approach direction. -->
    <!-- Roll the housing 90 degrees about its unchanged optical axis.  The
         narrower 58 degree image dimension now faces the inboard brush, while
         optical +Z still follows tool +Z onto the grasp window. -->
    <xacro:hf_d435 name="wrist_rgbd" parent="${wrist_parent}" xyz="0.140 0 0.025" rpy="${pi/2.0} -${pi/2.0} 0"
                    topic="/sensors/wrist_rgbd/depth/image_rect_raw"
                    ir_left_topic="/sensors/wrist_rgbd/infra1/image_rect_raw"
                    ir_right_topic="/sensors/wrist_rgbd/infra2/image_rect_raw" max_range="3.0" mount_bracket="true"
                    runtime_enabled="${high_bandwidth_runtime}"/>

    <!-- Independent modules: each has its own housing, imager, frame and topic. -->
    <link name="rear_left_fisheye_mount_link">
      <visual><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/rear_fisheye_mount.stl"/></geometry><material name="rear_camera_pod"><color rgba="0.055 0.070 0.073 1"/></material></visual>
      <collision name="rear_left_pod_back"><origin xyz="-0.018 0 0"/><geometry><box size="0.020 0.090 0.084"/></geometry></collision>
      <collision name="rear_left_pod_top"><origin xyz="0.004 0 0.038"/><geometry><box size="0.028 0.074 0.008"/></geometry></collision>
      <collision name="rear_left_pod_bottom"><origin xyz="0.004 0 -0.038"/><geometry><box size="0.028 0.074 0.008"/></geometry></collision>
      <inertial><mass value="0.14"/><xacro:hf_sensor_box_inertia mass="0.14" x="0.048" y="0.090" z="0.084"/></inertial>
    </link>
    <joint name="rear_left_fisheye_bracket_joint" type="fixed"><parent link="${base_parent}"/><child link="rear_left_fisheye_mount_link"/><origin xyz="-0.565 0.280 0.435" rpy="0 -0.175 2.705"/></joint>
    <xacro:hf_fisheye name="rear_left_fisheye" parent="rear_left_fisheye_mount_link" xyz="0 0 0" rpy="0 0 0"
                       optical_xyz="0.022011096607 -0.000604893394 -0.003891751553"
                       optical_rpy="-1.832595714594 -0.000035461162 -1.570996889205"
                       topic="/sensors/rear_left_fisheye/image_raw"
                       runtime_enabled="${high_bandwidth_runtime}"/>
    <link name="rear_right_fisheye_mount_link">
      <visual><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/rear_fisheye_mount.stl"/></geometry><material name="rear_camera_pod_right"><color rgba="0.055 0.070 0.073 1"/></material></visual>
      <collision name="rear_right_pod_back"><origin xyz="-0.018 0 0"/><geometry><box size="0.020 0.090 0.084"/></geometry></collision>
      <collision name="rear_right_pod_top"><origin xyz="0.004 0 0.038"/><geometry><box size="0.028 0.074 0.008"/></geometry></collision>
      <collision name="rear_right_pod_bottom"><origin xyz="0.004 0 -0.038"/><geometry><box size="0.028 0.074 0.008"/></geometry></collision>
      <inertial><mass value="0.14"/><xacro:hf_sensor_box_inertia mass="0.14" x="0.048" y="0.090" z="0.084"/></inertial>
    </link>
    <joint name="rear_right_fisheye_bracket_joint" type="fixed"><parent link="${base_parent}"/><child link="rear_right_fisheye_mount_link"/><origin xyz="-0.565 -0.280 0.435" rpy="0 -0.175 -2.705"/></joint>
    <xacro:hf_fisheye name="rear_right_fisheye" parent="rear_right_fisheye_mount_link" xyz="0 0 0" rpy="0 0 0"
                       optical_xyz="0.022011096607 0.000604893394 -0.003891751553"
                       optical_rpy="-1.832595714594 -0.000035461162 -1.570996889205"
                       topic="/sensors/rear_right_fisheye/image_raw"
                       runtime_enabled="${high_bandwidth_runtime}"/>

    <!-- The GNSS installation is split into its real functional parts.  The
         ZED-F9P-04B LGA receiver sits in a serviceable mast-side enclosure;
         the ANN-MB antenna remains on a separate sky-view boom.  Gazebo's
         NavSat measurement datum stays at the antenna phase-centre link. -->
    <link name="zed_f9p_receiver_enclosure_link">
      <visual name="zed_f9p_receiver_enclosure_visual">
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/zed_f9p_receiver_enclosure.stl"/></geometry>
        <material name="zed_f9p_receiver_tray"><color rgba="0.26 0.29 0.30 1"/></material>
      </visual>
      <collision name="zed_f9p_receiver_enclosure_collision">
        <origin xyz="0 0 -0.002"/><geometry><box size="0.065 0.060 0.020"/></geometry>
      </collision>
      <!-- The receiver hardware is split from the existing 0.240 kg GNSS
           mounting allocation, so this detail does not add fictitious mass. -->
      <inertial><origin xyz="0 0 -0.002"/><mass value="0.034999"/><xacro:hf_sensor_box_inertia mass="0.034999" x="0.065" y="0.060" z="0.020"/></inertial>
    </link>
    <joint name="zed_f9p_receiver_enclosure_mount_joint" type="fixed">
      <parent link="${mast_parent}"/><child link="zed_f9p_receiver_enclosure_link"/>
      <origin xyz="-0.060 -0.095 0.585"/>
    </joint>
    <link name="zed_f9p_module_reference_link">
      <visual name="zed_f9p_module_reference_visual">
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/zed_f9p_module_reference.stl"/></geometry>
        <material name="zed_f9p_module_shield"><color rgba="0.72 0.74 0.70 1"/></material>
      </visual>
      <collision name="zed_f9p_official_package_collision"><geometry><box size="0.017 0.022 0.0024"/></geometry></collision>
      <!-- u-blox does not publish a module mass in the selected public product
           material.  Epsilon mass preserves the explicit rigid body without
           inventing a hardware-correlated number; enclosure mass remains the
           conservative engineering allocation above. -->
      <inertial><mass value="0.000001"/><inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/></inertial>
    </link>
    <joint name="zed_f9p_module_reference_joint" type="fixed">
      <parent link="zed_f9p_receiver_enclosure_link"/><child link="zed_f9p_module_reference_link"/>
      <origin xyz="0 0 0.006"/>
    </joint>

    <!-- ANN-MB GNSS antenna sits on a dedicated side boom so the MID-360 has
         an unobstructed 360-degree crown and the antenna retains sky view. -->
    <link name="gnss_mount_link">
      <visual><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/gnss_mount.stl"/></geometry><material name="gnss_mount_silver"><color rgba="0.45 0.49 0.50 1"/></material></visual>
      <collision name="gnss_boom_collision"><origin xyz="0 0.085 0"/><geometry><box size="0.100 0.230 0.018"/></geometry></collision>
      <collision name="gnss_ground_plane_collision"><origin xyz="-0.020 0.180 0.010"/><geometry><cylinder radius="0.075" length="0.002"/></geometry></collision>
      <inertial><origin xyz="0 0.085 0"/><mass value="0.205"/><xacro:hf_sensor_box_inertia mass="0.205" x="0.100" y="0.230" z="0.073"/></inertial>
    </link>
    <joint name="gnss_bracket_joint" type="fixed"><parent link="${mast_parent}"/><child link="gnss_mount_link"/><origin xyz="-0.035 -0.020 0.765"/></joint>
    <link name="gnss_antenna_link">
      <visual name="ann_mb_mesh"><origin xyz="0 0 -0.01125"/>
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/antenna_ANN_MB.stl"/></geometry></visual>
      <collision><geometry><box size="0.0607 0.083 0.0225"/></geometry></collision>
      <inertial><mass value="0.173"/><inertia ixx="0.000091" ixy="0" ixz="0" iyy="0.000060" iyz="0" izz="0.000130"/></inertial>
    </link>
    <joint name="gnss_antenna_mount_joint" type="fixed"><parent link="gnss_mount_link"/><child link="gnss_antenna_link"/>
      <origin xyz="-0.020 0.180 0.026"/></joint>
    <gazebo reference="gnss_antenna_link">
      <sensor name="zed_f9p" type="navsat"><topic>/sensors/gnss/fix</topic><update_rate>10</update_rate>
        <always_on>true</always_on><gz_frame_id>gnss_antenna_link</gz_frame_id>
        <!-- Gazebo NavSat horizontal noise is expressed in degrees. 9e-8 deg
             is approximately 1 cm at the equator, matching the RTK target. -->
        <navsat><position_sensing><horizontal><noise type="gaussian"><mean>0</mean><stddev>0.00000009</stddev></noise></horizontal>
          <vertical><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></vertical></position_sensing></navsat>
      </sensor>
    </gazebo>

    <!-- VN-100 Rugged body is internally isolated near the vehicle CoG. -->
    <link name="imu_mount_tray_link">
      <visual><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/imu_mount_tray.stl"/></geometry><material name="imu_tray"><color rgba="0.40 0.44 0.45 1"/></material></visual>
      <collision><origin xyz="0 0 0.008"/><geometry><box size="0.090 0.080 0.022"/></geometry></collision>
      <inertial><origin xyz="0 0 0.008"/><mass value="0.12"/><xacro:hf_sensor_box_inertia mass="0.12" x="0.090" y="0.080" z="0.022"/></inertial>
    </link>
    <joint name="imu_tray_joint" type="fixed"><parent link="${base_parent}"/><child link="imu_mount_tray_link"/><origin xyz="0 0 0.225"/></joint>
    <link name="imu_link">
      <!-- Invert Robotnik's base-to-measurement-frame offset so imu_link
           remains the Gazebo/ROS measurement frame. -->
      <visual name="vn100_mesh"><origin xyz="0.00745 0 -0.0088"/>
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/robotnik_sensors/vectornav_vn100.stl"/></geometry></visual>
      <collision><origin xyz="0.00745 0 -0.0043"/><geometry><box size="0.036 0.037 0.009"/></geometry></collision>
      <inertial><origin xyz="0.00745 0 -0.0043"/><mass value="0.015"/><xacro:hf_sensor_box_inertia mass="0.015" x="0.036" y="0.037" z="0.009"/></inertial>
    </link>
    <joint name="imu_mount_joint" type="fixed"><parent link="imu_mount_tray_link"/><child link="imu_link"/>
      <origin xyz="0 0 0.019"/></joint>
    <gazebo reference="imu_link">
      <sensor name="vn100" type="imu"><topic>/sensors/imu/data</topic><update_rate>200</update_rate><always_on>true</always_on>
        <gz_frame_id>imu_link</gz_frame_id><imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00061</stddev><bias_mean>0</bias_mean><bias_stddev>0.00002</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00061</stddev><bias_mean>0</bias_mean><bias_stddev>0.00002</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00061</stddev><bias_mean>0</bias_mean><bias_stddev>0.00002</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.04</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.04</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.04</stddev></noise></z>
          </linear_acceleration>
        </imu></sensor>
    </gazebo>
  </xacro:macro>
</robot>
