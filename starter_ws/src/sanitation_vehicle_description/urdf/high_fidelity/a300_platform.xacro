<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Project-authored collision/visual model of the Clearpath Husky A300 40 Ah.
    No vendor mesh is redistributed.  The 0.990 x 0.698 x 0.372 m envelope and
    78.5 kg curb mass are frozen by pre_urdf_contract.yaml.  The wheelbase and
    track below are layout values and must be rechecked against a dimensioned
    A300 drawing before fabrication.
  -->

  <xacro:macro name="hf_box_inertia" params="mass x y z">
    <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
             iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
             izz="${mass * (x*x + y*y) / 12.0}"/>
  </xacro:macro>

  <xacro:macro name="hf_a300_wheel" params="name x y">
    <link name="${name}_wheel_link">
      <visual name="${name}_tire_visual">
        <origin rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="0.186" length="0.114"/></geometry>
        <material name="${name}_tire"><color rgba="0.035 0.040 0.045 1"/></material>
      </visual>
      <visual name="${name}_hub_visual">
        <origin rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="0.078" length="0.118"/></geometry>
        <material name="${name}_hub"><color rgba="0.28 0.31 0.33 1"/></material>
      </visual>
      <collision name="${name}_wheel_collision">
        <origin rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="0.186" length="0.114"/></geometry>
      </collision>
      <inertial>
        <mass value="3.0"/>
        <inertia ixx="0.029196" ixy="0" ixz="0"
                 iyy="0.051894" iyz="0" izz="0.029196"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} 0.0"/>
      <axis xyz="0 1 0"/>
      <limit effort="250" velocity="12.2"/>
      <dynamics damping="0.15" friction="0.05"/>
    </joint>
    <gazebo reference="${name}_wheel_link">
      <mu1>0.9</mu1><mu2>0.72</mu2>
      <kp>1000000</kp><kd>100</kd>
      <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="hf_a300_platform" params="">
    <!-- Virtual REP-105 ground projection. It is intentionally massless so
         KDL consumers do not treat the tree root as a physical rigid body. -->
    <link name="base_footprint"/>

    <link name="base_link">
      <visual name="lower_frame_visual">
        <origin xyz="0 0 0.055"/>
        <geometry><box size="0.990 0.584 0.262"/></geometry>
        <material name="a300_yellow"><color rgba="0.94 0.65 0.05 1"/></material>
      </visual>
      <visual name="front_bumper_visual">
        <origin xyz="0.476 0 0.035"/>
        <geometry><box size="0.038 0.698 0.145"/></geometry>
        <material name="a300_bumper"><color rgba="0.08 0.09 0.10 1"/></material>
      </visual>
      <visual name="rear_bumper_visual">
        <origin xyz="-0.476 0 0.035"/>
        <geometry><box size="0.038 0.698 0.145"/></geometry>
        <material name="a300_bumper_rear"><color rgba="0.08 0.09 0.10 1"/></material>
      </visual>
      <collision name="base_collision">
        <origin xyz="0 0 0.055"/>
        <geometry><box size="0.990 0.584 0.262"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.035 0 0.045"/>
        <mass value="61.499"/>
        <xacro:hf_box_inertia mass="61.499" x="0.990" y="0.584" z="0.262"/>
      </inertial>
    </link>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0.186"/>
    </joint>

    <link name="payload_deck_link">
      <visual name="deck_plate_visual">
        <geometry><box size="0.825 0.555 0.030"/></geometry>
        <material name="a300_deck"><color rgba="0.18 0.21 0.23 1"/></material>
      </visual>
      <collision name="deck_plate_collision"><geometry><box size="0.825 0.555 0.030"/></geometry></collision>
      <inertial>
        <mass value="4.0"/>
        <xacro:hf_box_inertia mass="4.0" x="0.825" y="0.555" z="0.030"/>
      </inertial>
    </link>
    <joint name="payload_deck_joint" type="fixed">
      <parent link="base_link"/><child link="payload_deck_link"/>
      <origin xyz="0 0 0.204"/>
    </joint>

    <!-- Structural mast is intentionally a separate physical link so its
         flexibility and sensor payload can be refined without changing base inertia. -->
    <link name="sensor_mast_link">
      <visual name="mast_column_visual">
        <origin xyz="0 0 0.360"/>
        <geometry><box size="0.060 0.060 0.720"/></geometry>
        <material name="mast_black"><color rgba="0.06 0.07 0.08 1"/></material>
      </visual>
      <visual name="mast_crossbar_visual">
        <origin xyz="0 0 0.700"/>
        <geometry><box size="0.090 0.480 0.040"/></geometry>
        <material name="mast_crossbar"><color rgba="0.11 0.13 0.14 1"/></material>
      </visual>
      <collision name="mast_column_collision"><origin xyz="0 0 0.360"/><geometry><box size="0.060 0.060 0.720"/></geometry></collision>
      <collision name="mast_crossbar_collision">
        <origin xyz="0 0 0.700"/>
        <geometry><box size="0.090 0.480 0.040"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.360"/>
        <mass value="1.0"/>
        <xacro:hf_box_inertia mass="1.0" x="0.060" y="0.060" z="0.720"/>
      </inertial>
    </link>
    <joint name="sensor_mast_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="sensor_mast_link"/>
      <origin xyz="-0.135 0 0.020"/>
    </joint>

    <!-- Arm mounting datum: centered toward the forward deck to preserve rear
         bin volume.  Final transform remains subject to the CoG/collision gate. -->
    <link name="arm_mount_link">
      <visual><geometry><cylinder radius="0.120" length="0.030"/></geometry>
        <material name="arm_mount_gray"><color rgba="0.32 0.34 0.36 1"/></material></visual>
      <collision><geometry><cylinder radius="0.120" length="0.030"/></geometry></collision>
      <inertial><mass value="0.001"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial>
    </link>
    <joint name="arm_mount_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="arm_mount_link"/>
      <origin xyz="0.035 -0.145 0.065"/>
    </joint>

    <!-- UR e-Series standard control box.  The public cabinet envelope is
         oriented with its shallow axis across the vehicle.  Its rear face is
         tangent to, but does not enter, the frozen dry-bin envelope. -->
    <link name="ur5e_control_box_link">
      <visual name="control_box_cabinet">
        <geometry><box size="0.460 0.254 0.449"/></geometry>
        <material name="control_box_blue"><color rgba="0.08 0.24 0.42 1"/></material>
      </visual>
      <visual name="control_box_front_panel">
        <origin xyz="0.232 0 0"/>
        <geometry><box size="0.004 0.220 0.390"/></geometry>
        <material name="control_box_panel"><color rgba="0.68 0.70 0.71 1"/></material>
      </visual>
      <collision><geometry><box size="0.460 0.254 0.449"/></geometry></collision>
      <inertial><mass value="12.0"/><xacro:hf_box_inertia mass="12.0" x="0.460" y="0.254" z="0.449"/></inertial>
    </link>
    <joint name="ur5e_control_box_mount_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="ur5e_control_box_link"/>
      <origin xyz="0.296 0.240 0.3045"/>
    </joint>

    <!-- S100/Journey 6 integration remains SKU-pending.  This is a public-
         reference 200 x 150 x 80 mm protective envelope plus mounting plate,
         not a claim about the user's eventual board dimensions.  The 2 kg
         allowance is assigned to the enclosure; the board datum carries only
         epsilon mass so no unmeasured board mass is invented. -->
    <link name="s100_compute_enclosure_link">
      <visual name="s100_enclosure_body"><geometry><box size="0.200 0.150 0.080"/></geometry>
        <material name="s100_enclosure_black"><color rgba="0.07 0.08 0.09 1"/></material></visual>
      <visual name="s100_mounting_plate"><origin xyz="0 0 -0.045"/><geometry><box size="0.230 0.180 0.010"/></geometry>
        <material name="s100_plate"><color rgba="0.34 0.36 0.38 1"/></material></visual>
      <collision><geometry><box size="0.200 0.150 0.080"/></geometry></collision>
      <collision name="s100_plate_collision"><origin xyz="0 0 -0.045"/><geometry><box size="0.230 0.180 0.010"/></geometry></collision>
      <inertial><origin xyz="0 0 -0.004"/><mass value="1.999999"/>
        <xacro:hf_box_inertia mass="1.999999" x="0.210" y="0.160" z="0.090"/></inertial>
    </link>
    <joint name="s100_compute_enclosure_mount_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="s100_compute_enclosure_link"/>
      <origin xyz="0.300 -0.270 0.100"/>
    </joint>
    <link name="s100_board_reference_link">
      <visual name="s100_pending_board_visual"><geometry><box size="0.150 0.100 0.004"/></geometry>
        <material name="s100_pending_board"><color rgba="0.04 0.42 0.20 0.45"/></material></visual>
      <collision><geometry><box size="0.150 0.100 0.004"/></geometry></collision>
      <inertial><mass value="0.000001"/><inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/></inertial>
    </link>
    <joint name="s100_board_reference_joint" type="fixed">
      <parent link="s100_compute_enclosure_link"/><child link="s100_board_reference_link"/>
      <origin xyz="0 0 0"/>
    </joint>

    <!-- A300 skid-steer layout.  Wheelbase 0.580 m and 0.584 m tire-centre
         track are project layout values within the published outer envelope. -->
    <xacro:hf_a300_wheel name="front_left"  x="0.290"  y="0.292"/>
    <xacro:hf_a300_wheel name="front_right" x="0.290"  y="-0.292"/>
    <xacro:hf_a300_wheel name="rear_left"   x="-0.290" y="0.292"/>
    <xacro:hf_a300_wheel name="rear_right"  x="-0.290" y="-0.292"/>

    <gazebo reference="base_link"><selfCollide>false</selfCollide></gazebo>
  </xacro:macro>
</robot>
