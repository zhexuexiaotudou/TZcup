<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Clearpath Husky A300 40 Ah nominal model.  Visible chassis, livery, status
    lights, top plate and tyres are the BSD-3-Clause Clearpath meshes pinned in
    meshes/vendor/SOURCES.yaml.  Primitive geometry remains only for collision
    and inertia.  Physical tyre radius follows the official description mesh;
    the controller uses the separately published 0.1625 m effective radius.
  -->

  <xacro:macro name="hf_box_inertia" params="mass x y z">
    <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
             iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
             izz="${mass * (x*x + y*y) / 12.0}"/>
  </xacro:macro>

  <xacro:macro name="hf_a300_wheel" params="name side x y">
    <link name="${name}_wheel_link">
      <visual name="${name}_tire_visual">
        <origin rpy="0 0 ${pi if side == 'right' else 0}"/>
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/clearpath_a300/drivetrain/wheels/outdoor_${side}.stl"/></geometry>
        <material name="${name}_tire"><color rgba="0.035 0.040 0.045 1"/></material>
      </visual>
      <collision name="${name}_wheel_collision">
        <origin rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="0.1651" length="0.1143"/></geometry>
      </collision>
      <inertial>
        <mass value="2.5"/>
        <inertia ixx="0.024420" ixy="0" ixz="0"
                 iyy="0.034073" iyz="0" izz="0.024420"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} 0.0"/>
      <axis xyz="0 1 0"/>
      <limit effort="250" velocity="12.2"/>
      <dynamics damping="0.15" friction="0.05"/>
    </joint>
    <gazebo reference="${name}_wheel_link">
      <mu1>0.9</mu1><mu2>0.72</mu2>
      <kp>1000000</kp><kd>100</kd>
      <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="hf_a300_platform" params="">
    <!-- Virtual REP-105 ground projection. It is intentionally massless so
         KDL consumers do not treat the tree root as a physical rigid body. -->
    <link name="base_footprint"/>

    <link name="base_link">
      <visual name="a300_chassis_visual">
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/clearpath_a300/chassis.dae"/></geometry>
      </visual>
      <visual name="a300_livery_visual">
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/clearpath_a300/livery.dae"/></geometry>
      </visual>
      <visual name="a300_status_lights_visual">
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/clearpath_a300/status_lights.dae"/></geometry>
      </visual>
      <collision name="base_collision">
        <origin xyz="0 0 0.11478"/>
        <geometry><box size="0.860 0.378 0.22956"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.041 0.003 0.070"/>
        <!-- Chassis allocation keeps base + four wheels + standard top plate at
             the published 78.5 kg 40 Ah A300 curb mass. The custom mast remains payload. -->
        <mass value="64.5"/>
        <xacro:hf_box_inertia mass="64.5" x="0.860" y="0.378" z="0.22956"/>
      </inertial>
    </link>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0.1651"/>
    </joint>

    <link name="payload_deck_link">
      <visual name="deck_plate_visual">
        <origin xyz="0 0 -0.204"/>
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/vendor/clearpath_a300/attachments/top_plate.dae"/></geometry>
      </visual>
      <collision name="deck_plate_collision"><geometry><box size="0.825 0.555 0.030"/></geometry></collision>
      <inertial>
        <mass value="4.0"/>
        <xacro:hf_box_inertia mass="4.0" x="0.825" y="0.555" z="0.030"/>
      </inertial>
    </link>
    <joint name="payload_deck_joint" type="fixed">
      <parent link="base_link"/><child link="payload_deck_link"/>
      <origin xyz="0 0 0.204"/>
    </joint>

    <!-- Bolted twin-column sensor tower.  Sensor-specific shelves are separate
         physical links in sensor_suite.xacro, so every load path is visible
         and no sensor is represented as floating on an anonymous crossbar. -->
    <link name="sensor_mast_link">
      <visual name="machined_sensor_mast_visual">
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/sensor_mast.stl"/></geometry>
        <material name="mast_anodized_aluminum"><color rgba="0.30 0.33 0.34 1"/></material>
      </visual>
      <collision name="mast_left_column_collision"><origin xyz="0 -0.050 0.396"/><geometry><box size="0.030 0.030 0.760"/></geometry></collision>
      <collision name="mast_right_column_collision"><origin xyz="0 0.050 0.396"/><geometry><box size="0.030 0.030 0.760"/></geometry></collision>
      <collision name="mast_service_spine_collision"><origin xyz="-0.022 0 0.375"/><geometry><box size="0.036 0.062 0.690"/></geometry></collision>
      <collision name="mast_pedestal_collision"><origin xyz="0 0 0.008"/><geometry><box size="0.190 0.150 0.016"/></geometry></collision>
      <collision name="mast_head_plate_collision"><origin xyz="0 0 0.778"/><geometry><box size="0.150 0.120 0.018"/></geometry></collision>
      <inertial>
        <origin xyz="0 0 0.390"/>
        <mass value="1.45"/>
        <xacro:hf_box_inertia mass="1.45" x="0.150" y="0.150" z="0.780"/>
      </inertial>
    </link>
    <joint name="sensor_mast_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="sensor_mast_link"/>
      <origin xyz="-0.135 0 0.020"/>
    </joint>

    <!-- Arm mounting datum: centered toward the forward deck to preserve rear
         bin volume.  Final transform remains subject to the CoG/collision gate. -->
    <link name="arm_mount_link">
      <visual><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/arm_mount_adapter.stl"/></geometry>
        <material name="arm_mount_gray"><color rgba="0.32 0.34 0.36 1"/></material></visual>
      <collision name="arm_backing_plate_collision"><origin xyz="0 0 -0.044"/><geometry><box size="0.280 0.220 0.012"/></geometry></collision>
      <collision name="arm_pedestal_collision"><origin xyz="0 0 -0.018"/><geometry><box size="0.180 0.180 0.040"/></geometry></collision>
      <collision name="arm_adapter_collision"><origin xyz="0 0 0.013"/><geometry><cylinder radius="0.120" length="0.056"/></geometry></collision>
      <inertial><origin xyz="0 0 -0.005"/><mass value="6.5"/><inertia ixx="0.035100" ixy="0" ixz="0" iyy="0.035100" iyz="0" izz="0.048100"/></inertial>
    </link>
    <joint name="arm_mount_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="arm_mount_link"/>
      <origin xyz="0.100 -0.200 0.065"/>
    </joint>

    <!-- UR e-Series standard control box.  The public cabinet envelope is
         oriented with its shallow axis across the vehicle.  Its rear face is
         tangent to, but does not enter, the frozen dry-bin envelope. -->
    <link name="ur5e_control_box_link">
      <visual name="control_box_cabinet">
        <geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/ur5e_control_cabinet.stl"/></geometry>
        <material name="control_box_blue"><color rgba="0.08 0.24 0.42 1"/></material>
      </visual>
      <collision><geometry><box size="0.460 0.254 0.449"/></geometry></collision>
      <inertial><mass value="12.0"/><xacro:hf_box_inertia mass="12.0" x="0.460" y="0.254" z="0.449"/></inertial>
    </link>
    <joint name="ur5e_control_box_mount_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="ur5e_control_box_link"/>
      <origin xyz="0.296 0.240 0.3045"/>
    </joint>

    <!-- S100/Journey 6 integration remains SKU-pending.  This is a public-
         reference 200 x 150 x 80 mm protective envelope plus mounting plate,
         not a claim about the user's eventual board dimensions.  The 2 kg
         allowance is assigned to the enclosure; the board datum carries only
         epsilon mass so no unmeasured board mass is invented. -->
    <link name="s100_compute_enclosure_link">
      <visual name="s100_enclosure_body"><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/s100_compute_enclosure.stl"/></geometry>
        <material name="s100_enclosure_black"><color rgba="0.07 0.08 0.09 1"/></material></visual>
      <collision><geometry><box size="0.205 0.155 0.100"/></geometry></collision>
      <collision name="s100_plate_collision"><origin xyz="0 0 -0.045"/><geometry><box size="0.230 0.180 0.010"/></geometry></collision>
      <inertial><origin xyz="0 0 -0.004"/><mass value="1.999999"/>
        <xacro:hf_box_inertia mass="1.999999" x="0.210" y="0.160" z="0.090"/></inertial>
    </link>
    <joint name="s100_compute_enclosure_mount_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="s100_compute_enclosure_link"/>
      <origin xyz="0.300 -0.270 0.100"/>
    </joint>
    <link name="s100_board_reference_link">
      <visual name="s100_pending_board_visual"><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/s100_board_reference.stl"/></geometry>
        <material name="s100_pending_board"><color rgba="0.04 0.42 0.20 0.45"/></material></visual>
      <collision><geometry><box size="0.150 0.100 0.004"/></geometry></collision>
      <inertial><mass value="0.000001"/><inertia ixx="0.000000001" ixy="0" ixz="0" iyy="0.000000001" iyz="0" izz="0.000000001"/></inertial>
    </link>
    <joint name="s100_board_reference_joint" type="fixed">
      <parent link="s100_compute_enclosure_link"/><child link="s100_board_reference_link"/>
      <origin xyz="0 0 0"/>
    </joint>

    <!-- Explicit protected power path: A300 battery/VBAT enters a fused PDU,
         an isolated converter supplies sensors/compute, and the safety relay
         removes cleaning/manipulator enable independently of software. -->
    <link name="power_distribution_box_link">
      <visual><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/power_distribution_box.stl"/></geometry>
        <material name="pdu_red"><color rgba="0.45 0.055 0.045 1"/></material></visual>
      <collision><geometry><box size="0.190 0.125 0.068"/></geometry></collision>
      <inertial><mass value="0.700"/><xacro:hf_box_inertia mass="0.700" x="0.190" y="0.125" z="0.068"/></inertial>
    </link>
    <joint name="power_distribution_box_mount_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="power_distribution_box_link"/>
      <origin xyz="0.330 0.025 0.075"/>
    </joint>

    <link name="isolated_dc_dc_module_link">
      <visual><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/isolated_dc_dc_module.stl"/></geometry>
        <material name="dc_dc_blue"><color rgba="0.055 0.22 0.36 1"/></material></visual>
      <collision><geometry><box size="0.140 0.100 0.055"/></geometry></collision>
      <inertial><mass value="0.400"/><xacro:hf_box_inertia mass="0.400" x="0.140" y="0.100" z="0.055"/></inertial>
    </link>
    <joint name="isolated_dc_dc_mount_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="isolated_dc_dc_module_link"/>
      <origin xyz="0.345 -0.105 0.070"/>
    </joint>

    <link name="safety_relay_link">
      <visual><geometry><mesh filename="package://sanitation_vehicle_description/meshes/generated/platform/safety_relay.stl"/></geometry>
        <material name="safety_relay_yellow"><color rgba="0.92 0.58 0.035 1"/></material></visual>
      <collision><geometry><box size="0.110 0.080 0.065"/></geometry></collision>
      <inertial><mass value="0.250"/><xacro:hf_box_inertia mass="0.250" x="0.110" y="0.080" z="0.065"/></inertial>
    </link>
    <joint name="safety_relay_mount_joint" type="fixed">
      <parent link="payload_deck_link"/><child link="safety_relay_link"/>
      <origin xyz="0.220 -0.080 0.075"/>
    </joint>

    <!-- Current Clearpath A300 wheelbase and tyre-centre track. -->
    <xacro:hf_a300_wheel name="front_left"  side="left"  x="0.256"  y="0.283"/>
    <xacro:hf_a300_wheel name="front_right" side="right" x="0.256"  y="-0.283"/>
    <xacro:hf_a300_wheel name="rear_left"   side="left"  x="-0.256" y="0.283"/>
    <xacro:hf_a300_wheel name="rear_right"  side="right" x="-0.256" y="-0.283"/>

    <gazebo reference="base_link"><selfCollide>false</selfCollide></gazebo>
  </xacro:macro>
</robot>
