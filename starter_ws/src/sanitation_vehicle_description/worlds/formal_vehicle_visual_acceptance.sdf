<?xml version="1.0"?>
<sdf version="1.11">
  <world name="formal_vehicle_visual_acceptance">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>39.9042</latitude_deg>
      <longitude_deg>116.4074</longitude_deg>
      <elevation>43.5</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.46 0.49 0.48 1</ambient>
      <background>0.82 0.85 0.84 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light name="key_light" type="directional">
      <pose>2 -2 6 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.45 0.30 -0.84</direction>
      <diffuse>0.95 0.94 0.90 1</diffuse>
      <specular>0.35 0.35 0.32 1</specular>
    </light>
    <light name="fill_light" type="point">
      <pose>-2.5 2.0 3.0 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.50 0.62 0.66 1</diffuse>
      <specular>0.12 0.16 0.18 1</specular>
      <attenuation><range>10</range><constant>0.45</constant><linear>0.08</linear><quadratic>0.015</quadratic></attenuation>
    </light>
    <light name="rim_light" type="point">
      <pose>-2.0 -2.5 2.2 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.42 0.50 0.45 1</diffuse>
      <specular>0.10 0.12 0.10 1</specular>
      <attenuation><range>9</range><constant>0.55</constant><linear>0.10</linear><quadratic>0.02</quadratic></attenuation>
    </light>

    <model name="studio_ground">
      <static>true</static>
      <link name="ground">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material>
            <ambient>0.56 0.59 0.58 1</ambient>
            <diffuse>0.70 0.73 0.71 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="front_left_acceptance_camera">
      <static>true</static>
      <pose>2.55 2.05 1.32 0 0.20 -2.46</pose>
      <link name="camera_link">
        <sensor name="front_left" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/front_left</topic>
          <camera><horizontal_fov>0.88</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="rear_right_acceptance_camera">
      <static>true</static>
      <pose>-2.50 -2.00 1.32 0 0.20 0.69</pose>
      <link name="camera_link">
        <sensor name="rear_right" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/rear_right</topic>
          <camera><horizontal_fov>0.88</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="top_cleaning_acceptance_camera">
      <static>true</static>
      <pose>0 0 3.20 0 1.570796 0</pose>
      <link name="camera_link">
        <sensor name="top_cleaning" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/top_cleaning</topic>
          <camera><horizontal_fov>0.75</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="sensor_tower_detail_camera">
      <static>true</static>
      <pose>1.45 1.30 1.46 0 0.143704 -2.240829</pose>
      <link name="camera_link">
        <sensor name="sensor_tower_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/sensor_tower_detail</topic>
          <camera><horizontal_fov>0.55</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="front_sensor_detail_camera">
      <static>true</static>
      <pose>1.60 0 0.76 0 0.142661 3.141593</pose>
      <link name="camera_link">
        <sensor name="front_sensor_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/front_sensor_detail</topic>
          <camera><horizontal_fov>0.52</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="arm_mount_detail_camera">
      <static>true</static>
      <pose>1.45 -1.45 1.32 0 0.310000 2.394637</pose>
      <link name="camera_link">
        <sensor name="arm_mount_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/arm_mount_detail</topic>
          <camera><horizontal_fov>0.80</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="dry_deposition_detail_camera">
      <static>true</static>
      <pose>-0.205 1.25 1.28 0 0.22 -1.5708</pose>
      <link name="camera_link">
        <sensor name="dry_deposition_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/dry_deposition_detail</topic>
          <camera><horizontal_fov>0.52</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>

    <!-- The following four views close the previous visual blind spots.  In
         product mode they prove the installed covers and external service
         interfaces.  With bodywork_visible:=false the same calibrated cameras
         expose the cleaning drive, rear safety/drain hardware, power/compute
         bay, and separated dry/wet storage and recovery plumbing. -->
    <model name="cleaning_head_detail_camera">
      <static>true</static>
      <pose>1.35 1.15 0.35 0 0.12 -2.436</pose>
      <link name="camera_link">
        <sensor name="cleaning_head_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/cleaning_head_detail</topic>
          <camera><horizontal_fov>0.70</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="rear_service_detail_camera">
      <static>true</static>
      <pose>-1.45 0 0.65 0 0.10 0</pose>
      <link name="camera_link">
        <sensor name="rear_service_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/rear_service_detail</topic>
          <camera><horizontal_fov>0.66</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="power_compute_detail_camera">
      <static>true</static>
      <pose>1.35 -1.25 0.95 0 0.130680 2.214297</pose>
      <link name="camera_link">
        <sensor name="power_compute_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/power_compute_detail</topic>
          <camera><horizontal_fov>0.62</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="storage_recovery_detail_camera">
      <static>true</static>
      <pose>-1.35 -1.15 0.90 0 0.15 0.705</pose>
      <link name="camera_link">
        <sensor name="storage_recovery_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/storage_recovery_detail</topic>
          <camera><horizontal_fov>0.62</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="rear_left_sensor_detail_camera">
      <static>true</static>
      <pose>-1.35 1.15 0.95 0 0.289 -0.836</pose>
      <link name="camera_link">
        <sensor name="rear_left_sensor_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/rear_left_sensor_detail</topic>
          <camera><horizontal_fov>0.48</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="rear_right_sensor_detail_camera">
      <static>true</static>
      <pose>-1.35 -1.15 0.95 0 0.289 0.836</pose>
      <link name="camera_link">
        <sensor name="rear_right_sensor_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/rear_right_sensor_detail</topic>
          <camera><horizontal_fov>0.48</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
