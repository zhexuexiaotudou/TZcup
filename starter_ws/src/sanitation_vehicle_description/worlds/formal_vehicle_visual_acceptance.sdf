    </model>
    <model name="drivetrain_detail_camera">
      <static>true</static>
      <pose>1.15 -1.00 0.30 0 0.084 2.505</pose>
      <link name="camera_link">
        <sensor name="drivetrain_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/drivetrain_detail</topic>
          <camera><horizontal_fov>0.60</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="inertial_power_detail_camera">
      <static>true</static>
      <pose>1.15 1.10 0.52 0 0.0696 -2.3784</pose>
      <link name="camera_link">
        <sensor name="inertial_power_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/inertial_power_detail</topic>
          <camera><horizontal_fov>0.52</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="dry_deposition_internal_camera">
      <static>true</static>
      <pose>-1.20 0.75 1.30 0 0.203 -0.623</pose>
      <link name="camera_link">
        <sensor name="dry_deposition_internal" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/dry_deposition_internal</topic>
          <camera><horizontal_fov>0.58</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="power_safety_internal_camera">
      <static>true</static>
      <pose>1.15 -1.00 0.80 0 0.269 2.380</pose>
      <link name="camera_link">
        <sensor name="power_safety_internal" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/power_safety_internal</topic>
          <camera><horizontal_fov>0.72</horizontal_fov><image><width>1600</width><height>1000</height><format>R8G8B8</format></image><clip><near>0.08</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="charge_interface_detail_camera">
      <static>true</static>
      <pose>0.50 1.20 0.70 0 0.240 -1.874</pose>
      <link name="camera_link">
        <sensor name="charge_interface_detail" type="camera">
          <always_on>true</always_on><update_rate>0.2</update_rate><topic>/formal_visual/charge_interface_detail</topic>
