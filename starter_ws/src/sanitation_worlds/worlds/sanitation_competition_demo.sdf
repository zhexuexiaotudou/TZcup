<?xml version="1.0"?>
<sdf version="1.9">
  <world name="sanitation_competition_demo">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <gravity>0 0 -9.81</gravity>
    <physics name="developer_fast_2x" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>2.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.68 0.70 0.72 1</ambient>
      <background>0.58 0.76 0.91 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>-4 -6 20 0 0 0</pose>
      <diffuse>0.98 0.94 0.84 1</diffuse><direction>-0.35 0.25 -1</direction>
    </light>

    <!-- A physically independent 16 m x 12 m acceptance arena.  It is not a
         crop or fence placed inside any of the campus-scale worlds. -->
    <model name="demo_arena_floor">
      <static>true</static><pose>-8 -1.5 -0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 12 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 12 0.08</size></box></geometry>
          <material><ambient>0.22 0.25 0.27 1</ambient><diffuse>0.28 0.30 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cleaning_lane_surface">
      <static>true</static><pose>-8 -1.5 0.008 0 0 0</pose><link name="link">
        <visual name="visual"><geometry><box><size>6 5 0.012</size></box></geometry>
          <material><ambient>0.34 0.38 0.41 1</ambient><diffuse>0.34 0.38 0.41 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Orange: full task allocation. Cyan: the inset area that is actually
         scored for cleaning after the 1.0 m safety headland is reserved. -->
    <model name="cleaning_boundary_north"><static>true</static><pose>-8 1.04 0.02 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>6.1 0.08 0.02</size></box></geometry><material><ambient>0.96 0.55 0.08 1</ambient><diffuse>0.96 0.55 0.08 1</diffuse></material></visual></link></model>
    <model name="cleaning_boundary_south"><static>true</static><pose>-8 -4.04 0.02 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>6.1 0.08 0.02</size></box></geometry><material><ambient>0.96 0.55 0.08 1</ambient><diffuse>0.96 0.55 0.08 1</diffuse></material></visual></link></model>
    <model name="cleaning_boundary_west"><static>true</static><pose>-11.04 -1.5 0.02 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.08 5.1 0.02</size></box></geometry><material><ambient>0.96 0.55 0.08 1</ambient><diffuse>0.96 0.55 0.08 1</diffuse></material></visual></link></model>
    <model name="cleaning_boundary_east"><static>true</static><pose>-4.96 -1.5 0.02 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.08 5.1 0.02</size></box></geometry><material><ambient>0.96 0.55 0.08 1</ambient><diffuse>0.96 0.55 0.08 1</diffuse></material></visual></link></model>
    <model name="actual_cleaning_boundary_north"><static>true</static><pose>-8 0.04 0.025 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>4.1 0.07 0.025</size></box></geometry><material><ambient>0.08 0.82 1 1</ambient><diffuse>0.08 0.82 1 1</diffuse></material></visual></link></model>
    <model name="actual_cleaning_boundary_south"><static>true</static><pose>-8 -3.04 0.025 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>4.1 0.07 0.025</size></box></geometry><material><ambient>0.08 0.82 1 1</ambient><diffuse>0.08 0.82 1 1</diffuse></material></visual></link></model>
    <model name="actual_cleaning_boundary_west"><static>true</static><pose>-10.04 -1.5 0.025 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.07 3.1 0.025</size></box></geometry><material><ambient>0.08 0.82 1 1</ambient><diffuse>0.08 0.82 1 1</diffuse></material></visual></link></model>
    <model name="actual_cleaning_boundary_east"><static>true</static><pose>-5.96 -1.5 0.025 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.07 3.1 0.025</size></box></geometry><material><ambient>0.08 0.82 1 1</ambient><diffuse>0.08 0.82 1 1</diffuse></material></visual></link></model>

    <model name="home_dock">
      <static>true</static><pose>-8 2.45 0.16 0 0 0</pose><link name="link">
        <collision name="collision"><geometry><box><size>1.3 0.45 0.32</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>1.3 0.45 0.32</size></box></geometry><material><ambient>0.05 0.24 0.39 1</ambient><diffuse>0.05 0.35 0.55 1</diffuse></material></visual>
        <visual name="charge"><pose>0 -0.235 0 0 0 0</pose><geometry><box><size>0.5 0.02 0.15</size></box></geometry><material><ambient>0.1 1 0.55 1</ambient><diffuse>0.1 1 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="start_zone"><static>true</static><pose>-8 0 0.018 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.6</radius><length>0.015</length></cylinder></geometry><material><ambient>0.12 0.72 1 0.75</ambient><diffuse>0.12 0.72 1 0.75</diffuse></material></visual></link></model>

    <!-- Safety furniture around the test cell creates curb, narrow-passage and
         pedestrian interactions without obstructing the nominal cleaning zone. -->
    <model name="curb_north"><static>true</static><pose>-8 3.45 0.10 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>13 0.25 0.20</size></box></geometry></collision><visual name="v"><geometry><box><size>13 0.25 0.20</size></box></geometry><material><ambient>0.75 0.76 0.72 1</ambient><diffuse>0.75 0.76 0.72 1</diffuse></material></visual></link></model>
    <model name="curb_south"><static>true</static><pose>-8 -6.45 0.10 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>13 0.25 0.20</size></box></geometry></collision><visual name="v"><geometry><box><size>13 0.25 0.20</size></box></geometry><material><ambient>0.75 0.76 0.72 1</ambient><diffuse>0.75 0.76 0.72 1</diffuse></material></visual></link></model>
    <model name="safety_barrier_west"><static>true</static><pose>-14.6 -1.5 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.25 7.5 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.25 7.5 0.7</size></box></geometry><material><ambient>0.92 0.45 0.06 1</ambient><diffuse>0.92 0.45 0.06 1</diffuse></material></visual></link></model>
    <model name="safety_barrier_east"><static>true</static><pose>-1.4 -1.5 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.25 7.5 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.25 7.5 0.7</size></box></geometry><material><ambient>0.92 0.45 0.06 1</ambient><diffuse>0.92 0.45 0.06 1</diffuse></material></visual></link></model>
    <model name="competition_bin"><static>true</static><pose>-12.7 -4.8 0.55 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.75 0.65 1.1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.75 0.65 1.1</size></box></geometry><material><ambient>0.08 0.45 0.25 1</ambient><diffuse>0.08 0.45 0.25 1</diffuse></material></visual></link></model>
    <model name="pedestrian_dummy"><static>true</static><pose>-3.1 2.25 0 0 0 0</pose><link name="link"><collision name="c"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry></collision><visual name="body"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.24</radius><length>1.35</length></cylinder></geometry><material><ambient>0.92 0.24 0.18 1</ambient><diffuse>0.92 0.24 0.18 1</diffuse></material></visual><visual name="head"><pose>0 0 1.72 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.86 0.65 0.48 1</ambient><diffuse>0.86 0.65 0.48 1</diffuse></material></visual></link></model>

    <!-- Competition cleaning targets. Their map coordinates are declared in
         competition_demo_area.yaml and judged only while the brush is on. -->
    <model name="target_bottle_demo"><static>true</static><pose>-9.6 -2.675 0.035 0 1.57 0.2</pose><link name="link"><visual name="body"><geometry><cylinder><radius>0.033</radius><length>0.22</length></cylinder></geometry><material><ambient>0.05 0.52 0.86 0.85</ambient><diffuse>0.05 0.52 0.86 0.85</diffuse></material></visual><visual name="cap"><pose>0 0 0.124 0 0 0</pose><geometry><cylinder><radius>0.016</radius><length>0.028</length></cylinder></geometry><material><ambient>0.9 0.2 0.15 1</ambient><diffuse>0.9 0.2 0.15 1</diffuse></material></visual></link></model>
    <model name="target_can_demo"><static>true</static><pose>-8 -2.025 0.034 0 1.57 0.4</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.115</length></cylinder></geometry><material><ambient>0.76 0.79 0.82 1</ambient><diffuse>0.76 0.79 0.82 1</diffuse></material></visual></link></model>
    <model name="target_paper_demo"><static>true</static><pose>-6.5 -1.375 0.003 0 0 0.25</pose><link name="link"><visual name="v"><geometry><box><size>0.21 0.15 0.004</size></box></geometry><material><ambient>0.96 0.95 0.80 1</ambient><diffuse>0.96 0.95 0.80 1</diffuse></material></visual></link></model>
    <model name="target_cardboard_demo"><static>true</static><pose>-9 -0.725 0.03 0 0 0.5</pose><link name="link"><visual name="v"><geometry><box><size>0.24 0.17 0.06</size></box></geometry><material><ambient>0.58 0.36 0.16 1</ambient><diffuse>0.67 0.43 0.22 1</diffuse></material></visual></link></model>
    <model name="target_leaf_pile_demo"><static>true</static><pose>-7 -0.075 0.003 0 0 0</pose><link name="link"><visual name="a"><pose>-0.08 0.02 0 0 0 0.35</pose><geometry><box><size>0.11 0.038 0.004</size></box></geometry><material><ambient>0.62 0.32 0.05 1</ambient><diffuse>0.62 0.32 0.05 1</diffuse></material></visual><visual name="b"><pose>0.02 0.065 0 0 0 -0.55</pose><geometry><box><size>0.09 0.032 0.004</size></box></geometry><material><ambient>0.78 0.48 0.04 1</ambient><diffuse>0.78 0.48 0.04 1</diffuse></material></visual><visual name="c"><pose>0.085 -0.02 0 0 0 0.75</pose><geometry><box><size>0.10 0.035 0.004</size></box></geometry><material><ambient>0.46 0.24 0.03 1</ambient><diffuse>0.46 0.24 0.03 1</diffuse></material></visual><visual name="d"><pose>-0.015 -0.06 0 0 0 -0.15</pose><geometry><box><size>0.08 0.03 0.004</size></box></geometry><material><ambient>0.70 0.40 0.04 1</ambient><diffuse>0.70 0.40 0.04 1</diffuse></material></visual></link></model>
    <model name="puddle_demo"><static>true</static><pose>-12.6 -0.8 0.003 0 0 0</pose><link name="link"><visual name="a"><pose>-0.08 0 0 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.004</length></cylinder></geometry><material><ambient>0.04 0.32 0.52 0.50</ambient><diffuse>0.04 0.32 0.52 0.50</diffuse></material></visual><visual name="b"><pose>0.10 0.05 0 0 0 0</pose><geometry><cylinder><radius>0.14</radius><length>0.004</length></cylinder></geometry><material><ambient>0.04 0.32 0.52 0.45</ambient><diffuse>0.04 0.32 0.52 0.45</diffuse></material></visual><visual name="c"><pose>0.08 -0.08 0 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.004</length></cylinder></geometry><material><ambient>0.04 0.32 0.52 0.45</ambient><diffuse>0.04 0.32 0.52 0.45</diffuse></material></visual></link></model>
  </world>
</sdf>
