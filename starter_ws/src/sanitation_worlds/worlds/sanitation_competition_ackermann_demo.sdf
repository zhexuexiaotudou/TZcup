    <model name="cleaning_boundary_west"><static>true</static><pose>-15.84 -1.50 0.02 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.08 10.1 0.02</size></box></geometry><material><ambient>0.96 0.55 0.08 1</ambient><diffuse>0.96 0.55 0.08 1</diffuse></material></visual></link></model>
    <model name="cleaning_boundary_east"><static>true</static><pose>-0.16 -1.50 0.02 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.08 10.1 0.02</size></box></geometry><material><ambient>0.96 0.55 0.08 1</ambient><diffuse>0.96 0.55 0.08 1</diffuse></material></visual></link></model>
