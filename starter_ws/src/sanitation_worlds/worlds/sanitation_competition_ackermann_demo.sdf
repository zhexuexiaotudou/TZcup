    <model name="actual_cleaning_boundary_south"><static>true</static><pose>-8 -3.04 0.025 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>4.1 0.07 0.025</size></box></geometry><material><ambient>0.08 0.82 1 1</ambient><diffuse>0.08 0.82 1 1</diffuse></material></visual></link></model>
    <model name="actual_cleaning_boundary_west"><static>true</static><pose>-10.04 -1.5 0.025 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.07 3.1 0.025</size></box></geometry><material><ambient>0.08 0.82 1 1</ambient><diffuse>0.08 0.82 1 1</diffuse></material></visual></link></model>
