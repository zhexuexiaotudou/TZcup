    <!-- Static scene dressing is parked east of the safety barrier.  The
         separately named dynamic_pedestrian_box is the only pedestrian moved
         through the arena by formal obstacle trials. -->
    <model name="pedestrian_dummy"><static>true</static><pose>1.2 2.25 0 0 0 0</pose><link name="link"><collision name="c"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry></collision><visual name="body"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.24</radius><length>1.35</length></cylinder></geometry><material><ambient>0.92 0.24 0.18 1</ambient><diffuse>0.92 0.24 0.18 1</diffuse></material></visual><visual name="head"><pose>0 0 1.72 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.86 0.65 0.48 1</ambient><diffuse>0.86 0.65 0.48 1</diffuse></material></visual></link></model>

    <!-- Parked outside the arena during nominal demos. Formal dynamic trials
         move this physical model through the active swath using SetEntityPose. -->
    <model name="dynamic_pedestrian_box">
      <static>false</static><pose>25 18 0 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity><kinematic>true</kinematic>
        <collision name="collision"><pose>0 0 0.85 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>1.70</length></cylinder></geometry></collision>
        <visual name="body"><pose>0 0 0.85 0 0 0</pose><geometry><cylinder><radius>0.24</radius><length>1.30</length></cylinder></geometry><material><ambient>0.96 0.38 0.08 1</ambient><diffuse>0.96 0.38 0.08 1</diffuse></material></visual>
