<?xml version="1.0"?>
<sdf version="1.9">
  <world name="sanitation_competition_ackermann_demo">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation><latitude_deg>31.2304</latitude_deg><longitude_deg>121.4737</longitude_deg><elevation>0</elevation><heading_deg>0</heading_deg></spherical_coordinates>
    <gravity>0 0 -9.81</gravity>
    <physics name="developer_fast_2x" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>2.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.68 0.70 0.72 1</ambient>
      <background>0.58 0.76 0.91 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>-4 -6 20 0 0 0</pose>
      <diffuse>0.98 0.94 0.84 1</diffuse><direction>-0.35 0.25 -1</direction>
    </light>

    <!-- Dedicated Ackermann turning-apron arena. The cyan scored rectangle
         and all ten target poses are unchanged; only the grey/orange apron
        grows to admit collision-free forward Dubins connectors at the
        1.429 m centre radius / 2.01 m swept envelope. -->
    <model name="demo_arena_floor">
      <static>true</static><pose>-8 -1.5 -0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 12 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 12 0.08</size></box></geometry>
          <material><ambient>0.22 0.25 0.27 1</ambient><diffuse>0.28 0.30 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cleaning_lane_surface">
      <static>true</static><pose>-8 -1.5 0.008 0 0 0</pose><link name="link">
        <visual name="visual"><geometry><box><size>15.6 10.0 0.012</size></box></geometry>
          <material><ambient>0.34 0.38 0.41 1</ambient><diffuse>0.34 0.38 0.41 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Orange: full task allocation. Cyan: the inset area that is actually
         scored for cleaning after the 1.0 m safety headland is reserved. -->
    <model name="cleaning_boundary_north"><static>true</static><pose>-8 3.54 0.02 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>15.7 0.08 0.02</size></box></geometry><material><ambient>0.96 0.55 0.08 1</ambient><diffuse>0.96 0.55 0.08 1</diffuse></material></visual></link></model>
