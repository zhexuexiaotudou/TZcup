<?xml version="1.0"?>
<window>
  <width>1500</width>
  <height>920</height>
  <style material_theme="Dark" material_primary="Blue" material_accent="Teal"/>
</window>
<plugin filename="MinimalScene" name="3D View">
    <gz-gui><property type="bool" key="showTitleBar">false</property></gz-gui>
    <engine>ogre2</engine>
    <scene>scene</scene>
    <ambient_light>0.6 0.6 0.6</ambient_light>
    <background_color>0.72 0.84 0.94</background_color>
    <camera_pose>-16 -16 18 0 0.65 0.78</camera_pose>
</plugin>
<plugin filename="WorldControl" name="仿真物理控制">
    <gz-gui><property type="bool" key="showTitleBar">false</property></gz-gui>
    <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
</plugin>
<plugin filename="WorldStats" name="仿真时间">
    <gz-gui><property type="bool" key="showTitleBar">false</property></gz-gui>
    <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor>
</plugin>
<plugin filename="SanitationMissionControl" name="清扫任务控制">
    <scene_label>小型演示 · 30 m × 20 m</scene_label>
    <gz-gui>
      <property type="string" key="state">docked</property>
      <property type="string" key="resizable">true</property>
      <property type="double" key="width">370</property>
      <property type="double" key="height">430</property>
    </gz-gui>
</plugin>
