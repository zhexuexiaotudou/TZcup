<?xml version="1.0"?>
<window>
  <width>1500</width><height>920</height>
  <style material_theme="Dark" material_primary="Blue" material_accent="Teal"/>
</window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <ambient_light>0.6 0.6 0.6</ambient_light><background_color>0.72 0.84 0.94</background_color>
  <camera_pose>-38 -38 42 0 0.70 0.78</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui></plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control"><gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui></plugin>
<plugin filename="CameraTracking" name="Camera Tracking"><gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui></plugin>
<plugin filename="MarkerManager" name="Marker manager"><gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui></plugin>
<plugin filename="SelectEntities" name="Select Entities"><gz-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></gz-gui></plugin>
<plugin filename="WorldControl" name="仿真物理控制"><play_pause>true</play_pause><step>true</step><start_paused>false</start_paused></plugin>
<plugin filename="WorldStats" name="仿真时间"><sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor></plugin>
<plugin filename="SanitationMissionControl" name="清扫任务控制"><scene_label>中型验证 · 80 m × 50 m</scene_label><gz-gui><property type="string" key="state">docked</property><property type="double" key="width">370</property><property type="double" key="height">430</property></gz-gui></plugin>
