# ROS / colcon outputs
build/
install/
log/
.work/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# ROS bag payloads are evidence but are too large for normal Git history.
artifacts/**/*.db3
artifacts/**/*.mcap
artifacts/**/metadata.yaml

# Stage4W raw screening/formal runs stay local; compact review evidence is tracked.
artifacts/stage4w_static_screening*/
artifacts/stage4w_static_*screening*/
artifacts/stage4w_static_formal*/
artifacts/stage4w_static_pre_dynamic_clearance_config/
artifacts/stage4w_dynamic_*/
artifacts/stage4w_localization_regression/
artifacts/stage4w_localization_regression_*/
artifacts/stage4w_localization_reweight_probe_*/

# Stage5A raw datasets, generated ONNX models, workspaces, and MCAP stay local.
artifacts/stage5a_formal*/
artifacts/stage5a_live_formal*/
artifacts/stage5a_screening*/
artifacts/stage5a_*_raw*/
artifacts/stage5a_stage4w_regression*/

# Stage5B raw datasets, checkpoints, generated assets, workspaces, and rosbag stay local.
artifacts/stage5b_screening*/
artifacts/stage5b_formal*/
artifacts/stage5b_*_raw*/
artifacts/stage5b_live*/
artifacts/stage5b_nav2*/
artifacts/stage5b_stage4w_regression*/
artifacts/stage5b_stage5a_regression*/

# Stage5BR raw Gazebo frames, checkpoints, failed attempts, MCAP, and regressions
# stay local; only artifacts/stage5br_20260719_review is versioned.
artifacts/stage5br_phase_a_run*/
artifacts/stage5br_g1_*/
artifacts/stage5br_ros_validation*/
artifacts/stage5br_stage4w_regression*/
artifacts/stage5br_stage5a_regression*/

# Stage5BR6W full Docker/ROS runtime logs and bags stay local; only the compact
# artifacts/stage5br6w_20260721_review evidence directory is versioned.
artifacts/stage5br6w_*_runtime/
artifacts/stage5br6w_*postmerge*/

# Autonomous-stage full Docker/ROS runtime logs and bags stay local. Compact,
# reviewed acceptance evidence is versioned separately.
artifacts/autonomous_*_runtime*/
artifacts/autonomous_*_driver.stdout.log
artifacts/autonomous_*_driver.stderr.log
artifacts/autonomous_*_driver.pid
# AUTO-01 preserves every rejected/full ROS run locally; only the compact
# autonomous_auto01_<date>_evidence directory is committed.
artifacts/autonomous_auto01_g[12]_*/
artifacts/autonomous_auto01_g[12]_*.log
# AUTO-02 keeps the five-seed, dynamic, cold-start, logs, and MCAP evidence
# locally; a compact manifest-backed evidence directory is committed.
artifacts/autonomous_auto02_raw_*/
artifacts/autonomous_auto03_raw_*/
artifacts/autonomous_auto03_formal_*/
artifacts/autonomous_auto03_*_smoke/
artifacts/autonomous_auto04_*_raw/

# Stage5BR3 full Stage5A/Stage4W regression logs stay local; the compact
# machine-readable summary is versioned in artifacts/stage5br3_20260720_review.
artifacts/stage5br3_regression_stage5a*/
artifacts/stage5br3_regression_stage4w*/

# GPT review bundles stay local. Only AUTO-16 may create the final release ZIP.
无人清扫车仿真_GPT复核包_Stage*.zip
无人清扫车仿真_GPT复核包_Stage*.zip.sha256

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
.runtime_ws/
.env
.env.*

# Stage5BR6 human-review packages, sealed truth, and completed external responses
# must stay outside Git. Only redacted manifests and status evidence are versioned.
external_review_handoff/
external_reviews/
