{
  "schema_version": 1,
  "node": "/collision_monitor",
  "parameters": {
    "polygons": [
      "FootprintApproach"
    ],
    "source_timeout": 5.0,
    "cmd_vel_in_topic": "cmd_vel_smoothed",
    "cmd_vel_out_topic": "/cmd_vel_gate",
    "FootprintApproach": {
      "footprint_topic": "/local_costmap/published_footprint",
      "action_type": "approach"
    },
    "observation_sources": [
      "scan",
      "ground_cloud"
    ],
    "scan": {
      "topic": "scan"
    },
    "ground_cloud": {
      "topic": "/verification_camera/depth/color/points/navigation",
      "min_height": 0.05,
      "max_height": 2.0
    }
  },
  "pointcloud_self_filter": {
    "node": "/pointcloud_self_filter",
    "parameters": {
      "input_topic": "/verification_camera/depth/color/points",
      "output_topic": "/verification_camera/depth/color/points/navigation",
      "output_frame": "base_footprint",
      "mask_min_xyz_m": [
        -0.6,
        -0.43,
        -0.2
      ],
      "mask_max_xyz_m": [
        0.72,
        0.43,
        0.75
      ],
      "sampling_stride": 4
    }
  }
}
