+// A signal may interrupt one individual ZeroMQ send before that frame is
+// accepted. Retrying the complete multipart publication would duplicate the
+// frames already accepted by ZeroMQ and corrupt the stream, so retries must
+// stay scoped to the exact message_t currently being sent.
+constexpr unsigned int kPublishEintrRetryLimit = 3u;
+
+template<typename SendFlagsT>
+static void sendPublishFrameWithEintrRetry(zmq::socket_t &_publisher,
+    zmq::message_t &_frame, const SendFlagsT &_flags)
+{
+  unsigned int retryCount = 0u;
+  while (true)
+  {
+    try
+    {
+      _publisher.send(_frame, _flags);
+      return;
+    }
+    catch (const zmq::error_t &_error)
+    {
+      if (_error.num() != EINTR || retryCount >= kPublishEintrRetryLimit)
+        throw;
+      ++retryCount;
+    }
+  }
+}
