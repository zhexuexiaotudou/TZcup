{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tzcup.local/schema/native-brep-reconstruction-manifest-v1.json",
  "title": "TZcup native B-rep reconstruction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "status",
    "claim_boundary",
    "prohibited_methods",
    "source_generators",
    "profiles",
    "assemblies",
    "native_source_root",
    "step_root",
    "parts",
    "excluded_generator_outputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "document_id": {"type": "string", "minLength": 1},
    "status": {"const": "pending_native_brep_reconstruction"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "prohibited_methods": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_generators": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/generator"}},
    "profiles": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/profile"}},
    "assemblies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assembly"}},
    "native_source_root": {"type": "string", "minLength": 1},
    "step_root": {"type": "string", "minLength": 1},
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
    "excluded_generator_outputs": {"type": "array", "items": {"$ref": "#/$defs/excluded"}}
  },
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "generated_mesh_count"],
      "properties": {
        "id": {"enum": ["product_bodywork", "cleaning_storage", "power_service_hardware"]},
        "path": {"type": "string", "minLength": 1},
        "generated_mesh_count": {"type": "integer", "minimum": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_sources", "material_and_mass", "interface", "coordinate_system"],
      "properties": {
        "dimension_sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "material_and_mass": {"type": "object", "minProperties": 1},
        "interface": {"type": "object", "minProperties": 1},
        "coordinate_system": {"type": "object", "minProperties": 1}
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "target_native_source", "target_step_assembly", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "profile": {"type": "string", "minLength": 1},
        "target_native_source": {"type": "string", "pattern": "\\.FCStd$"},
        "target_step_assembly": {"type": "string", "pattern": "\\.step$"},
        "status": {"const": "pending_native_brep_reconstruction"}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_generator", "source_mesh", "source_definition", "profile", "target_native_source", "target_step_part", "target_step_assembly", "conversion_policy", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "source_generator": {"type": "string"},
        "source_mesh": {"type": "string", "pattern": "^[a-z0-9_./-]+\\.stl$"},
        "source_definition": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "target_native_source": {"type": "string", "pattern": "\\.FCStd$"},
        "target_step_part": {"type": "string", "pattern": "\\.step$"},
        "target_step_assembly": {"type": "string", "pattern": "\\.step$"},
        "conversion_policy": {"const": "native_brep_feature_rebuild_only"},
        "status": {"const": "pending_native_brep_reconstruction"}
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_generator", "source_mesh", "reason", "bom_reference", "status"],
      "properties": {
        "source_generator": {"type": "string"},
        "source_mesh": {"type": "string", "pattern": "^[a-z0-9_./-]+\\.stl$"},
        "reason": {"type": "string", "minLength": 1},
        "bom_reference": {"type": "string", "minLength": 1},
        "status": {"const": "excluded_non_project_authored_vendor_reference"}
      }
    }
  }
}
